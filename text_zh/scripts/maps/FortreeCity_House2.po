#: data/maps/FortreeCity_House2/scripts.inc:68
msgctxt "FortreeCity_House2_Text_YourHiddenPowerHasAwoken"
msgid ""
"Oh! Splendid!\n"
"Your hidden power has awoken!\p"
"Here, take this and awaken the hidden\n"
"power of your POKéMON.$"
msgstr ""
"哦！了不起！你隐藏的力量已经觉醒了！\p"
"来，收下这个，\n"
"去唤醒你的宝可梦隐藏的力量吧。$"

#: data/maps/FortreeCity_House2/scripts.inc:74
msgctxt "FortreeCity_House2_Text_ExplainHiddenPower"
msgid ""
"HIDDEN POWER is a move that changes\n"
"with the POKéMON.$"
msgstr ""
"觉醒力量是一种会随着\n"
"宝可梦而变化的招式。$"

#: data/maps/FortreeCity_House2/scripts.inc:78
msgctxt "FortreeCity_House2_Text_YouGuessedWrong"
msgid ""
"No, too bad.\n"
"You guessed wrong.$"
msgstr "不对，真可惜。你猜错了。$"
