msgid ""
"Great, great!\n"
"So, how much can you spot me?$"
msgstr ""
"好极了，好极了！\n"
"那么，你能借我多少呢？$"

#: data/maps/BattleFrontier_Lounge3/scripts.inc:325
msgctxt "BattleFrontier_Lounge3_Text_YouDontHaveEnoughPoints"
msgid ""
"Oh, no, no, no!\n"
"You don't have enough Battle Points!\p"
"I wish you wouldn't monkey around and\n"
"waste everyone's time!$"
msgstr ""
"哎呀，不行不行不行！\n"
"你的对战点数不够啊！\p"
"别瞎胡闹，\n"
"浪费大家的时间好吗！$"

