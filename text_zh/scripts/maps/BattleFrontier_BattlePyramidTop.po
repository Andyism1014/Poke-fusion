#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:216
msgctxt "BattleFrontier_BattlePyramidTop_Text_ReachedSummitUpYouGo"
msgid ""
"It is a delight to see you here!\n"
"You have reached the summit of\l"
"the BATTLE PYRAMID!\p"
"Above here is the PYRAMID's\n"
"lookout point.\p"
"It is a place open only to those\n"
"who have conquered the PYRAMID.\p"
"Now, please!\n"
"Up you go!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:227
msgctxt "BattleFrontier_BattlePyramidTop_Text_PlayerConqueredPyramid"
msgid ""
"The PYRAMID's new conqueror!\n"
"Let the name {PLAYER} be known!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:231
msgctxt "BattleFrontier_BattlePyramidTop_Text_ChiefBeatYouHere"
msgid ""
"It is a delight to see you here!\p"
"Unfortunately, you were second by\n"
"a mere fraction of time!\p"
"Our chief has already conquered\n"
"the PYRAMID ahead of you.\p"
"However, my young explorer…\n"
"You are a TRAINER!\p"
"Assert your power and take the glory\n"
"of the pinnacle from our chief!\p"
"Now, please! When you are ready,\n"
"take one more step of courage!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:244
msgctxt "BattleFrontier_BattlePyramidTop_Text_ExplorationsAreGrandestAdventure"
msgid ""
"Young adventurer…\p"
"Wouldn't you agree that explorations\n"
"are the grandest of adventures?\p"
"Your own wits!\p"
"Your own strength!\p"
"Your own POKéMON!\p"
"And, above all, only your own courage\n"
"to lead you through unknown worlds…$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:254
msgctxt "BattleFrontier_BattlePyramidTop_Text_ImPyramidKingBrandon"
msgid ""
"Aah, yes, indeed this life is grand!\n"
"Grand, it is! Eh?\p"
"I'm BRANDON!\p"
"I'm the PYRAMID KING, which means\n"
"I'm in charge here.\p"
"Most people call me the chief!\p"
"You coming here means you have\n"
"that much confidence in yourself,\l"
"am I right?\p"
"Hahahah!\n"
"This should be exciting!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:267
msgctxt "BattleFrontier_BattlePyramidTop_Text_BringCourageToOurBattle"
msgid ""
"Now, then!\n"
"Bring your courage to our battle!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:271
msgctxt "BattleFrontier_BattlePyramidTop_Text_BrandonFrontierPassPlease"
msgid ""
"BRANDON: Hahahah! Grand it was!\n"
"Grand, yes, indeed!\p"
"Well done! You've earned recognition!\n"
"Your FRONTIER PASS, please!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:277
msgctxt "BattleFrontier_BattlePyramidTop_Text_ReceivedBraveSymbol"
msgid ""
"The Brave Symbol was embossed on\n"
"the FRONTIER PASS!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:281
msgctxt "BattleFrontier_BattlePyramidTop_Text_LookForwardToNextMeeting"
msgid ""
"Young explorer!\n"
"I look forward to our next meeting!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:285
msgctxt "BattleFrontier_BattlePyramidTop_Text_BrandonYouveReturned"
msgid ""
"BRANDON: …You've finally returned,\n"
"young explorer…\p"
"Your love of adventure seems to come\n"
"deep from within your heart…\p"
"Yes… You are exactly as I was in\n"
"my own youth…\p"
"… … …Ah…\p"
"The passionate!\p"
"The dangerous!\p"
"The desperate!\p"
"Those days of death-defying,\n"
"life-affirming adventures are back…$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:299
msgctxt "BattleFrontier_BattlePyramidTop_Text_MyCourageIsOffMeter"
msgid ""
"Now, then!\p"
"I sense my own courage is off\n"
"the meter!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:304
msgctxt "BattleFrontier_BattlePyramidTop_Text_EverythingYouHave"
msgid ""
"Everything you have!\n"
"I'm braced for it all!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:308
msgctxt "BattleFrontier_BattlePyramidTop_Text_BrandonRemarkableHaveThis"
msgid ""
"BRANDON: Hahahah!\n"
"Remarkable!\l"
"Yes, it's grand, indeed!\p"
"Young explorer!\p"
"You've bested me through and through!\n"
"Here! I want you to have this!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:316
msgctxt "BattleFrontier_BattlePyramidTop_Text_BraveSymbolTookGoldenShine"
msgid ""
"The Brave Symbol took on\n"
"a golden shine!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:320
msgctxt "BattleFrontier_BattlePyramidTop_Text_FarewellForNow"
msgid ""
"Ah, yes! It just goes to show that\n"
"I have much to learn still!\p"
"May our paths cross again!\n"
"Farewell for now, young explorer!$"
msgstr ""

#: data/maps/BattleFrontier_BattlePyramidTop/scripts.inc:326
msgctxt "BattleFrontier_BattlePyramidTop_Text_StepForwardWhenReady"
msgid ""
"Now, when you are ready, take courage\n"
"and step forward.$"
msgstr ""
