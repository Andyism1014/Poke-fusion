#: data/maps/SlateportCity_Harbor/scripts.inc:383
msgctxt "SlateportCity_Harbor_Text_FerryServiceUnavailable"
msgid ""
"I beg your pardon?\n"
"You're looking for a ship?\p"
"I'm sorry, the ferry service isn't\n"
"available at present…$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:389
msgctxt "SlateportCity_Harbor_Text_MayISeeYourTicket"
msgid ""
"Hello, are you here for the ferry?\n"
"May I see your TICKET?$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:393
msgctxt "SlateportCity_Harbor_Text_YouMustHaveTicket"
msgid ""
"{PLAYER} doesn't have the TICKET…\p"
"I'm terribly sorry.\p"
"You must have a TICKET to board\n"
"the ferry.$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:399
msgctxt "SlateportCity_Harbor_Text_FlashedTicketWhereTo"
msgid ""
"{PLAYER} flashed the TICKET.\p"
"Perfect! That's all you need!\p"
"And where would you like to go?$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:404
msgctxt "SlateportCity_Harbor_Text_SailAnotherTime"
msgid "Please sail with us another time!$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:407
msgctxt "SlateportCity_Harbor_Text_LilycoveItIs"
msgid "LILYCOVE CITY it is, then!$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:410
msgctxt "SlateportCity_Harbor_Text_BattleFrontierItIs"
msgid "BATTLE FRONTIER it is, then!$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:413
msgctxt "SlateportCity_Harbor_Text_PleaseBoardFerry"
msgid ""
"Please board the ferry and wait for\n"
"departure.$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:417
msgctxt "SlateportCity_Harbor_Text_WhereWouldYouLikeToGo"
msgid "Then, where would you like to go?$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:420
msgctxt "SlateportCity_Harbor_Text_LoveToGoDeepUnderwaterSomeday"
msgid ""
"A journey to the bottom of the sea…\n"
"I wonder what it'd be like?\p"
"I'd love to go deep underwater like\n"
"that someday.$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:426
msgctxt "SlateportCity_Harbor_Text_AbnormalWeather"
msgid ""
"For a ship to sail safely, we need to\n"
"know about the weather!\p"
"Speaking of weather, I heard something\n"
"from a guy at the WEATHER INSTITUTE.\p"
"He was saying abnormal weather has\n"
"been reported all over the place!\p"
"You should visit the WEATHER INSTITUTE\n"
"and ask around!$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:436
msgctxt "SlateportCity_Harbor_Text_SubTooSmallForMe"
msgid ""
"I wanted to go with CAPT. STERN on\n"
"the ocean floor exploration.\p"
"But the sub's too small for me.\p"
"If I squeezed in, there wouldn't be\n"
"any room for the CAPTAIN…$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:443
msgctxt "SlateportCity_Harbor_Text_SameThugsTriedToRobAtMuseum"
msgid ""
"CAPT. STERN: Those thugs…\p"
"They're the same lot who tried to rob\n"
"the DEVON GOODS at the MUSEUM.$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:448
msgctxt "SlateportCity_Harbor_Text_ArchieYouAgainHideoutInLilycove"
msgid ""
"ARCHIE: Oh?\n"
"Not you again…\p"
"You are tenacious to track us here,\n"
"that much I will give you.\p"
"But now…\n"
"No one can stop us! No one!\p"
"Or, will you follow us back to our\n"
"HIDEOUT in LILYCOVE CITY?\p"
"Fwahahahaha…$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:459
msgctxt "SlateportCity_Harbor_Text_CaptSternWhyStealMySubmarine"
msgid ""
"CAPT. STERN: Why…\p"
"Why would TEAM AQUA steal my\n"
"SUBMARINE EXPLORER 1?\p"
"They can't be after the slumbering\n"
"POKéMON at the bottom of the sea…\p"
"But even if I were to chase them,\n"
"I don't stand a chance against them…$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:468
msgctxt "SlateportCity_Harbor_Text_TeamAquaLeftNeedDive"
msgid ""
"CAPT. STERN: Oh, {PLAYER}{KUN}…\p"
"Okay… So TEAM AQUA left before you\n"
"could stop them…\p"
"Oh, no, don't blame yourself.\n"
"You're not responsible for this.\p"
"Trying to catch a submarine…\n"
"It's impossible for most people.\p"
"You would need a POKéMON that knows\n"
"how to DIVE…\p"
"Perhaps if you went out to\n"
"MOSSDEEP CITY…\p"
"A lot of divers live out there, so\n"
"someone might teach you…$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:483
msgctxt "SlateportCity_Harbor_Text_NeedDiveToCatchSub"
msgid ""
"CAPT. STERN: Trying to catch a\n"
"submarine… It's impossible.\p"
"You would need a POKéMON that knows\n"
"how to DIVE…\p"
"Perhaps if you went out to\n"
"MOSSDEEP CITY…\p"
"A lot of divers live out there, so\n"
"someone might teach you…$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:493
msgctxt "SlateportCity_Harbor_Text_WontBeLongBeforeWeFinishFerry"
msgid ""
"CAPT. STERN: Oh, yes.\n"
"MR. BRINEY came to our SHIPYARD.\p"
"It won't be long now before we finish\n"
"making the ferry!$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:499
msgctxt "SlateportCity_Harbor_Text_FinishedMakingFerry"
msgid ""
"CAPT. STERN: {PLAYER}{KUN}!\p"
"We finally finished making the ferry\n"
"S.S. TIDAL!\p"
"We couldn't have done it without\n"
"your friend MR. BRINEY.\p"
"Please go for a short cruise on it!$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:507
msgctxt "SlateportCity_Harbor_Text_WouldYouTradeScanner"
msgid ""
"CAPT. STERN: Oh?\n"
"{PLAYER}{KUN}, that item you have…\p"
"That's a SCANNER! That would sure\n"
"help us on our explorations.\p"
"{PLAYER}{KUN}, would you trade your\n"
"SCANNER for something?\p"
"Like, say, a DEEPSEATOOTH or\n"
"a DEEPSEASCALE that I have?$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:517
msgctxt "SlateportCity_Harbor_Text_IfYouWantToTradeLetMeKnow"
msgid ""
"CAPT. STERN: Are you certain?\n"
"It's useless to you, {PLAYER}{KUN}…\p"
"Well, okay, then. If you want to trade\n"
"your SCANNER, let me know.$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:523
msgctxt "SlateportCity_Harbor_Text_TradeForDeepSeaTooth"
msgid ""
"CAPT. STERN: So you'll trade it for\n"
"my DEEPSEATOOTH?$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:527
msgctxt "SlateportCity_Harbor_Text_TradeForDeepSeaScale"
msgid ""
"CAPT. STERN: So you'll trade it for\n"
"my DEEPSEASCALE?$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:531
msgctxt "SlateportCity_Harbor_Text_WhichOneDoYouWant"
msgid "CAPT. STERN: Which one do you want?$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:534
msgctxt "SlateportCity_Harbor_Text_HandedScannerToStern"
msgid ""
"{PLAYER} handed the SCANNER to\n"
"CAPT. STERN.$"
msgstr ""

#: data/maps/SlateportCity_Harbor/scripts.inc:538
msgctxt "SlateportCity_Harbor_Text_ThisWillHelpResearch"
msgid ""
"CAPT. STERN: Thanks, {PLAYER}{KUN}!\n"
"This will help our research a lot!$"
msgstr ""
