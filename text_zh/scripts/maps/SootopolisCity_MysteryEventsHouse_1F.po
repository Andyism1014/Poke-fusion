msgstr "{STR_VAR_1}$"

#: data/maps/SootopolisCity_MysteryEventsHouse_1F/scripts.inc:223
msgctxt "SootopolisCity_MysteryEventsHouse_1F_Text_TooBadForYou"
msgid ""
"Ah, too bad for you!\p"
"But it was a good match.\n"
"I hope you can win next time.$"
msgstr ""
"啊，真可惜！\p"
"不过这是一场精彩的对战。\n"
"希望你下次能赢。$"
