msgstr "{STR_VAR_1}$"

#: data/maps/SootopolisCity_MysteryEventsHouse_1F/scripts.inc:214
msgctxt "SootopolisCity_MysteryEventsHouse_1F_Text_ThatWasSuperlative"
msgid ""
"That was superlative!\p"
"Why, it was like seeing myself in\n"
"my youth again!$"
msgstr ""
"太精彩了！\p"
"哎呀，就像又看到了\n"
"年轻时的自己一样！$"

#: data/maps/SootopolisCity_MysteryEventsHouse_1F/scripts.inc:220
msgctxt "SootopolisCity_MysteryEventsHouse_1F_Text_StrVar1Lost"
