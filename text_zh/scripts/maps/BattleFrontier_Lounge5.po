#: data/maps/BattleFrontier_Lounge5/scripts.inc:108
msgctxt "BattleFrontier_Lounge5_Text_NatureGirlEgg"
msgid ""
"That's silly! An EGG is asleep!\n"
"I can't talk to it!$"
msgstr ""
"好傻哦！蛋在睡觉呢！\n"
"我没办法和它说话！$"

#: data/maps/BattleFrontier_Lounge5/scripts.inc:112
msgctxt "BattleFrontier_Lounge5_Text_LadyClaimsSheUnderstandsPokemon"
msgid ""
"How charming!\n"
"That little lady claims she can\l"
"understand POKéMON!$"
msgstr ""
"真可爱！\n"
"那个小姑娘说她能听懂\l"
"宝可梦的心声呢！$"

#: data/maps/BattleFrontier_Lounge5/scripts.inc:117
msgctxt "BattleFrontier_Lounge5_Text_GirlSayingSomethingProfound"
msgid ""
"I have this feeling that the little girl\n"
"is saying something profound.$"
msgstr ""
"我总觉得那个小女孩\n"
"说的话很有深意。$"

#: data/maps/BattleFrontier_Lounge5/scripts.inc:121
msgctxt "BattleFrontier_Lounge5_Text_GirlPlaysAtRedHouseALot"
msgid ""
"I know something!\p"
"That little girl plays at the red house\n"
"a lot!$"
msgstr ""
"我知道一件事哦！\p"
"那个小女孩经常\n"
"在红色的房子里玩！$"
