#: data/maps/BattleFrontier_Lounge5/scripts.inc:44
msgctxt "BattleFrontier_Lounge5_Text_NatureGirlGreeting"
msgid ""
"Ehehe!\n"
"I can tell what POKéMON are thinking!\p"
"Please!\n"
"Can I see your POKéMON?$"
msgstr ""
"嘿嘿！\n"
"我知道宝可梦在想什么哦！\p"
"拜托！\n"
"可以给我看看你的宝可梦吗？$"

#: data/maps/BattleFrontier_Lounge5/scripts.inc:50
msgctxt "BattleFrontier_Lounge5_Text_NatureGirlNoneShown"
msgid ""
"Boo!\n"
"Cheapie!$"
msgstr ""
"哼！\n"
"小气鬼！$"

#: data/maps/BattleFrontier_Lounge5/scripts.inc:54
msgctxt "BattleFrontier_Lounge5_Text_NatureGirlAttackHighAttackLow"
msgid ""
"Hmhm…\p"
"This one says it likes to battle!\n"
"It will battle even if it has a lot\l"
"of ouchies!$"
msgstr ""
"嗯嗯……\p"
"这孩子说它喜欢战斗！\n"
"就算受了很多伤，\l"
"它也会继续战斗！$"

#: data/maps/BattleFrontier_Lounge5/scripts.inc:60
msgctxt "BattleFrontier_Lounge5_Text_NatureGirlAttackHighDefenseLow"
msgid ""
"Hmhm…\p"
"This one says it likes to battle!\n"
"But if it gets enough ouchies,\l"
"it will worry about itself!$"
msgstr ""
"嗯嗯……\p"
"这孩子说它喜欢战斗！\n"
"不过受了很多伤以后，\l"
"它就会担心自己！$"

#: data/maps/BattleFrontier_Lounge5/scripts.inc:66
msgctxt "BattleFrontier_Lounge5_Text_NatureGirlAttackHighSupportLow"
