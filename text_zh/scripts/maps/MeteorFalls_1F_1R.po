#: data/maps/MeteorFalls_1F_1R/scripts.inc:234
msgctxt "MeteorFalls_1F_1R_Text_WithThisMeteorite"
msgid ""
"Hehehe!\p"
"With this METEORITE, that thing in\n"
"MT. CHIMNEY will…$"
msgstr ""

#: data/maps/MeteorFalls_1F_1R/scripts.inc:239
msgctxt "MeteorFalls_1F_1R_Text_DontExpectMercyFromMagma"
msgid ""
"Heh?\p"
"I don't know who you are, but if you get\n"
"in the way of TEAM MAGMA, don't\l"
"expect any mercy!$"
msgstr ""

#: data/maps/MeteorFalls_1F_1R/scripts.inc:245
msgctxt "MeteorFalls_1F_1R_Text_HoldItRightThereMagma"
msgid ""
"Hold it right there, TEAM MAGMA!\p"
"You're badly mistaken if you think you\n"
"can have your way with the world!$"
msgstr ""

#: data/maps/MeteorFalls_1F_1R/scripts.inc:250
msgctxt "MeteorFalls_1F_1R_Text_BeSeeingYouTeamAqua"
msgid ""
"Hehehe!\n"
"Even TEAM AQUA joins us!\p"
"But it's too much trouble to deal with\n"
"you all…\p"
"Heh, it doesn't matter!\p"
"We've got the METEORITE, so off to\n"
"MT. CHIMNEY we go!\p"
"Hehehe! Be seeing you, you TEAM\n"
"AQUA dingbats!$"
msgstr ""

#: data/maps/MeteorFalls_1F_1R/scripts.inc:261
msgctxt "MeteorFalls_1F_1R_Text_ArchieSeenYouBefore"
msgid ""
"ARCHIE: Didn't I see you before?\n"
"At SLATEPORT's MUSEUM?\p"
"Ah, so your name is {PLAYER}.\p"
"At the time, I thought you were one\n"
"of TEAM MAGMA's goons.\p"
"Humph…\n"
"You're one odd kid.\p"
"TEAM MAGMA is a dangerous group of\n"
"total fanatics.\p"
"They engage in destruction, claiming\n"
"to expand the land mass.\p"
"They are the rivals to us,\n"
"the sea-loving TEAM AQUA!$"
msgstr ""

#: data/maps/MeteorFalls_1F_1R/scripts.inc:276
msgctxt "MeteorFalls_1F_1R_Text_BossWeShouldChaseMagma"
msgid ""
"BOSS, we should give chase to\n"
"TEAM MAGMA…$"
msgstr ""

#: data/maps/MeteorFalls_1F_1R/scripts.inc:280
msgctxt "MeteorFalls_1F_1R_Text_ArchieYesNoTellingWhatMagmaWillDo"
msgid ""
"ARCHIE: Yes, yes, we must!\n"
"We've got to hurry.\p"
"There's no telling what TEAM MAGMA\n"
"will do at MT. CHIMNEY!$"
msgstr ""

#: data/maps/MeteorFalls_1F_1R/scripts.inc:286
msgctxt "MeteorFalls_1F_1R_Text_ArchieFarewell"
msgid ""
"ARCHIE: {PLAYER}, you should keep\n"
"an eye out for TEAM MAGMA, too.\p"
"Farewell!$"
msgstr ""

#: data/maps/MeteorFalls_1F_1R/scripts.inc:291
msgctxt "MeteorFalls_1F_1R_Text_MeetProfCozmo"
msgid ""
"I… I'm COZMO…\n"
"I'm a PROFESSOR…\p"
"TEAM MAGMA asked me to guide them\n"
"to METEOR FALLS…\p"
"But they tricked me.\n"
"They even took my METEORITE away…\p"
"And then another similar bunch,\n"
"TEAM AQUA showed up.\p"
"After that…\n"
"I don't understand any of it.\p"
"But that TEAM MAGMA…\p"
"What are they going to do with that\n"
"METEORITE at MT. CHIMNEY?$"
msgstr ""

#: data/maps/MeteorFalls_1F_1R/scripts.inc:306
msgctxt "MeteorFalls_1F_1R_Text_WhatsTeamMagmaDoingAtMtChimney"
msgid ""
"PROF. COZMO: But that TEAM MAGMA…\p"
"What are they going to do with that\n"
"METEORITE at MT. CHIMNEY?$"
msgstr ""
