"you wish to enter, please.$"
msgstr ""

#: data/maps/BattleFrontier_BattleDomeLobby/scripts.inc:487
msgctxt "BattleFrontier_BattleDomeLobby_Text_NotEnoughValidMonsLvOpen"
msgid ""
"Excuse me!\p"
"You don't have three eligible POKéMON.\p"
"Also, the POKéMON must be holding\n"
"different kinds of items.\p"
"EGGS{STR_VAR_1}.$"
msgstr ""

#: data/maps/BattleFrontier_BattleDomeLobby/scripts.inc:494
msgctxt "BattleFrontier_BattleDomeLobby_Text_NotEnoughValidMonsEnd"
msgid "Please come see me when you are ready.$"
msgstr ""

#: data/maps/BattleFrontier_BattleDomeLobby/scripts.inc:497
msgctxt "BattleFrontier_BattleDomeLobby_Text_NotEnoughValidMonsLv50"
msgid ""
"Excuse me!\p"
"You don't have three eligible POKéMON.\p"
"You must have three different POKéMON\n"
