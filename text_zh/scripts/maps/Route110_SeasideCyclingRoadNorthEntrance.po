#: data/maps/Route110_SeasideCyclingRoadNorthEntrance/scripts.inc:55
msgctxt "Route110_SeasideCyclingRoadNorthEntrance_Text_GoAllOutOnCyclingRoad"
msgid ""
"On CYCLING ROAD, you can go all out\n"
"and cycle as fast as you'd like.\p"
"It feels great to go that fast, but try\n"
"not to crash into anyone!$"
msgstr ""
"在自行车道上，你可以尽情地全速骑行。\p"
"骑得那么快感觉很棒，\n"
"但小心别撞到别人！$"

#: data/maps/Route110_SeasideCyclingRoadNorthEntrance/scripts.inc:61
msgctxt "Route110_SeasideCyclingRoadNorthEntrance_Text_TooDangerousToWalk"
msgid ""
"Sorry, you can't walk on CYCLING\n"
"ROAD. It's too dangerous.\p"
"Please come back with a BIKE.$"
msgstr ""
"抱歉，自行车道上不能步行。太危险了。\p"
"请骑自行车再来吧。$"
