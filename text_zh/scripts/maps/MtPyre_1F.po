#: data/maps/MtPyre_1F/scripts.inc:28
msgctxt "MtPyre_1F_Text_TakeThisForYourOwnGood"
msgid ""
"All sorts of beings wander the slopes\n"
"of MT. PYRE…\p"
"There is no telling what may happen.\n"
"Take this. It's for your own good.$"
msgstr ""
"送神山的山坡上\n"
"徘徊着各种各样的存在……\p"
"谁也不知道会发生什么。\n"
"收下这个吧。这是为了你好。$"

#: data/maps/MtPyre_1F/scripts.inc:34
msgctxt "MtPyre_1F_Text_ExplainCleanseTag"
msgid ""
"Have a POKéMON hold that\n"
"CLEANSE TAG.\p"
"It will help ward off wild POKéMON.$"
msgstr ""
"让宝可梦携带那个洁净之符吧。\p"
"它能帮你驱赶野生的宝可梦。$"

#: data/maps/MtPyre_1F/scripts.inc:39
msgctxt "MtPyre_1F_Text_ComeToPayRespects"
msgid ""
"Did you come to pay your respect\n"
"to the spirits of departed POKéMON?\p"
"You must care for your POKéMON a lot.$"
msgstr ""
"你是来祭奠\n"
"逝去的宝可梦的灵魂的吗？\p"
"你一定很爱护你的宝可梦吧。$"

#: data/maps/MtPyre_1F/scripts.inc:44
msgctxt "MtPyre_1F_Text_RestingPlaceOfZigzagoon"
msgid ""
"This is the final resting place of my\n"
"ZIGZAGOON. I cherished it…$"
msgstr ""
"这里是我的蛇纹熊\n"
"长眠的地方。我非常珍爱它……$"
