#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:286
msgctxt "PlayersHouse_1F_Text_IsntItNiceInHere"
msgid ""
"MOM: See, {PLAYER}?\n"
"Isn't it nice in here, too?$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:290
msgctxt "PlayersHouse_1F_Text_MoversPokemonGoSetClock"
msgid ""
"The mover's POKéMON do all the work\n"
"of moving us in and cleaning up after.\l"
"This is so convenient!\p"
"{PLAYER}, your room is upstairs.\n"
"Go check it out, dear!\p"
"DAD bought you a new clock to mark\n"
"our move here.\l"
"Don't forget to set it!$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:300
msgctxt "PlayersHouse_1F_Text_ArentYouInterestedInRoom"
msgid ""
"MOM: Well, {PLAYER}?\p"
"Aren't you interested in seeing your\n"
"very own room?$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:305
msgctxt "PlayersHouse_1F_Text_GoSetTheClock"
msgid ""
"MOM: {PLAYER}.\p"
"Go set the clock in your room, honey.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:309
msgctxt "PlayersHouse_1F_Text_OhComeQuickly"
msgid ""
"MOM: Oh! {PLAYER}, {PLAYER}!\n"
"Quick! Come quickly!$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:313
msgctxt "PlayersHouse_1F_Text_MaybeDadWillBeOn"
msgid ""
"MOM: Look! It's PETALBURG GYM!\n"
"Maybe DAD will be on!$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:317
msgctxt "PlayersHouse_1F_Text_ItsOverWeMissedHim"
msgid ""
"MOM: Oh… It's over.\p"
"I think DAD was on, but we missed him.\n"
"Too bad.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:322
msgctxt "PlayersHouse_1F_Text_GoIntroduceYourselfNextDoor"
msgid ""
"Oh, yes.\n"
"One of DAD's friends lives in town.\p"
"PROF. BIRCH is his name.\p"
"He lives right next door, so you should\n"
"go over and introduce yourself.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:329
msgctxt "PlayersHouse_1F_Text_SeeYouHoney"
msgid "MOM: See you, honey!$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:332
msgctxt "PlayersHouse_1F_Text_DidYouMeetProfBirch"
msgid ""
"MOM: Did you introduce yourself to\n"
"PROF. BIRCH?$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:336
msgctxt "PlayersHouse_1F_Text_YouShouldRestABit"
msgid ""
"MOM: How are you doing, {PLAYER}?\n"
"You look a little tired.\p"
"I think you should rest a bit.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:341
msgctxt "PlayersHouse_1F_Text_TakeCareHoney"
msgid "MOM: Take care, honey!$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:344
msgctxt "PlayersHouse_1F_Text_GotDadsBadgeHeresSomethingFromMom"
msgid ""
"MOM: Oh? Did DAD give you that BADGE?\p"
"Then here's something from your MOM!$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:348
msgctxt "PlayersHouse_1F_Text_DontPushYourselfTooHard"
msgid ""
"Don't push yourself too hard, dear.\n"
"You can always come home.\p"
"Go for it, honey!$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:353
msgctxt "PlayersHouse_1F_Text_IsThatAPokenav"
msgid ""
"MOM: What is that, honey? A POKéNAV?\n"
"Someone from DEVON gave it to you?\p"
"Well, honey, how about registering\n"
"your mom?\p"
"… … …$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:360
msgctxt "PlayersHouse_1F_Text_RegisteredMom"
msgid ""
"Registered MOM\n"
"in the POKéNAV.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:364
msgctxt "PlayersHouse_1F_Text_Vigoroth1"
msgid "Fugiiiiih!$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:367
msgctxt "PlayersHouse_1F_Text_Vigoroth2"
msgid "Huggoh, uggo uggo…$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:370
msgctxt "PlayersHouse_1F_Text_ReportFromPetalburgGym"
msgid ""
"INTERVIEWER: …We brought you this\n"
"report from in front of PETALBURG GYM.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:374
msgctxt "PlayersHouse_1F_Text_TheresAMovieOnTV"
msgid ""
"There is a movie on TV.\p"
"Two men are dancing on a big piano\n"
"keyboard.\p"
"Better get going!$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:380
msgctxt "PlayersHouse_1F_Text_RunningShoesManual"
msgid ""
"It's the instruction booklet for the\n"
"RUNNING SHOES.\p"
"“Press the B Button to run while\n"
"wearing your RUNNING SHOES.\p"
"“Lace up your RUNNING SHOES and hit\n"
"the road running!”$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:388
msgctxt "PlayersHouse_1F_Text_TicketFromBrineyCameForYou"
msgid ""
"DAD: Hm?\p"
"Hey, it's {PLAYER}!\p"
"It's been a while since I saw you,\n"
"but you look…stronger, somehow.\p"
"That's the impression I get.\n"
"But your old man hasn't given up yet!\p"
"Oh, yes, I have something for you.\n"
"This came to you from someone named\l"
"MR. BRINEY.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:399
msgctxt "PlayersHouse_1F_Text_PortsInSlateportLilycove"
msgid ""
"DAD: Hm, a TICKET for a ferry?\p"
"If I recall, there are ferry ports in\n"
"SLATEPORT and LILYCOVE.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:404
msgctxt "PlayersHouse_1F_Text_BetterGetBackToGym"
msgid ""
"I'd better get back to PETALBURG GYM.\p"
"MOM, thanks for looking after the house\n"
"while I'm away.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:409
msgctxt "PlayersHouse_1F_Text_DadShouldStayLonger"
msgid ""
"MOM: That DAD of yours…\p"
"He comes home for the first time in a\n"
"while, but all he talks about is POKéMON.\p"
"He should relax and stay a little longer.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:415
msgctxt "PlayersHouse_1F_Text_IsThatABreakingStory"
msgid "MOM: Is that a breaking news story?$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:418
msgctxt "PlayersHouse_1F_Text_LatiEmergencyNewsFlash"
msgid ""
"We bring you this emergency\n"
"news flash!\p"
"In various HOENN locales, there have\n"
"been reports of a BZZT…colored\l"
"POKéMON in flight.\p"
"The identity of this POKéMON is\n"
"currently unknown.\p"
"We now return you to the regular\n"
"movie program.$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:429
msgctxt "PlayersHouse_1F_Text_WhatColorDidTheySay"
msgid ""
"MOM: {PLAYER}, did you catch that?\p"
"What color did the announcer say\n"
"that POKéMON was?$"
msgstr ""

#: data/maps/LittlerootTown_BrendansHouse_1F/scripts.inc:434
msgctxt "PlayersHouse_1F_Text_StillUnknownPokemon"
msgid ""
"MOM: Well, isn't that something!\n"
"There are still unknown POKéMON.$"
msgstr ""
