#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:386
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_WishIHadAllDolls"
msgid ""
"Oh, they're so nice!\n"
"I wish I had them!\l"
"Cute cushions!\l"
"Big plush DOLLS!\l"
"Little plush DOLLS!\l"
"I wish I had them all!$"
msgstr ""

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:394
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_GetYouAnythingYouWant"
msgid ""
"Leave it to your mommy!\p"
"If it's anything you want, I'll go\n"
"through anything to get it, honey!$"
msgstr ""

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:399
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_ItemsWillGetMonTougher"
msgid ""
"If I can get hold of the items here,\n"
"my POKéMON will get tougher.\p"
"You bet they will!\n"
"No question about it!$"
msgstr ""

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:405
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_GoGetYourOwnDoll"
msgid ""
"Hah?\n"
"What are you gawking at?\p"
"I don't like you staring at my plush\n"
"doll like that.\p"
"If you want it, go get one yourself!\n"
"Isn't that right, SMOOCHUM?$"
msgstr ""

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:413
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_MoreBattlePointsForRecord"
msgid ""
