#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:347
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_WelcomePleaseChoosePrize"
msgid ""
"Hello, this is the EXCHANGE SERVICE\n"
"CORNER.\p"
"We exchange the Battle Points you\n"
"have collected for lovely prizes.\p"
"Please choose a prize from this list.$"
msgstr ""
"你好，这里是兑换服务处。\p"
"我们可以把你收集的对战点数\n"
"兑换成精美的奖品。\p"
"请从这份清单中选择奖品。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:355
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_PleaseChoosePrize"
msgid "Please choose a prize from this list.$"
msgstr "请从这份清单中选择奖品。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:358
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_ConfirmPurchase"
msgid ""
"You've chosen the {STR_VAR_1}.\n"
"Is that correct?$"
msgstr ""
"你选择的是{STR_VAR_1}。\n"
"对吗？$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:362
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_WellSendItToPC"
msgid ""
"Thank you!\n"
"We'll send it to your PC at home.$"
msgstr ""
"谢谢！\n"
"我们会把它送到你家里的电脑。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:366
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_HereIsYourPrize"
msgid "Here is your prize!$"
msgstr "这是你的奖品！$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:369
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_DontHaveEnoughPoints"
msgid ""
"I'm so sorry…\n"
"You don't have enough Battle Points…$"
msgstr ""
"非常抱歉……\n"
"你的对战点数不够……$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:373
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_PCIsFull"
msgid ""
"I'm so sorry…\n"
"Your PC appears to be full…$"
msgstr ""
"非常抱歉……\n"
"你的电脑好像满了……$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:377
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_DontHaveSpaceToHoldIt"
msgid ""
"I'm so sorry…\n"
"You don't have space to hold it…$"
msgstr ""
"非常抱歉……\n"
"你没有地方放它了……$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:381
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_ThankYouVisitWithPoints"
msgid ""
"Thank you very much.\p"
"Please visit us when you have\n"
"saved up Battle Points.$"
msgstr ""
"非常感谢。\p"
"攒够对战点数以后\n"
"请再来吧。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:386
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_WishIHadAllDolls"
msgid ""
"Oh, they're so nice!\n"
"I wish I had them!\l"
"Cute cushions!\l"
"Big plush DOLLS!\l"
"Little plush DOLLS!\l"
"I wish I had them all!$"
msgstr ""
"哇，好棒啊！\n"
"我好想要！\l"
"可爱的坐垫！\l"
"大大的毛绒玩偶！\l"
"小小的毛绒玩偶！\l"
"我全都想要！$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:394
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_GetYouAnythingYouWant"
msgid ""
"Leave it to your mommy!\p"
"If it's anything you want, I'll go\n"
"through anything to get it, honey!$"
msgstr ""
"交给妈妈吧！\p"
"只要是你想要的东西，\n"
"妈妈不管怎样都会帮你弄到的！$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:399
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_ItemsWillGetMonTougher"
msgid ""
"If I can get hold of the items here,\n"
"my POKéMON will get tougher.\p"
"You bet they will!\n"
"No question about it!$"
msgstr ""
"只要能拿到这里的道具，\n"
"我的宝可梦就会变得更强。\p"
"肯定会的！\n"
"毫无疑问！$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:405
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_GoGetYourOwnDoll"
msgid ""
"Hah?\n"
"What are you gawking at?\p"
"I don't like you staring at my plush\n"
"doll like that.\p"
"If you want it, go get one yourself!\n"
"Isn't that right, SMOOCHUM?$"
msgstr ""
"啊？\n"
"你在盯着看什么？\p"
"我不喜欢你那样\n"
"盯着我的毛绒玩偶看。\p"
"想要的话，自己去换一个！\n"
"对吧，迷唇娃？$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:413
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_MoreBattlePointsForRecord"
msgid ""
"Did you know?\p"
"If you stretch your record at any of\n"
"the BATTLE facilities, they start\l"
"giving you more and more Battle Points.$"
msgstr ""
"你知道吗？\p"
"在任何一座对战设施里，\n"
"只要不断刷新纪录，\l"
"得到的对战点数就会越来越多。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:419
