#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:485
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_LeftoversDesc"
msgid ""
"A hold item that gradually restores\n"
"HP in battle.$"
msgstr ""
"携带后，在对战中\n"
"会逐渐回复HP。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:489
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_WhiteHerbDesc"
msgid ""
"A hold item that restores any\n"
"lowered stat.$"
msgstr ""
"携带后，能让降低的能力\n"
"恢复原状。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:493
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_QuickClawDesc"
msgid ""
"A hold item that occasionally allows\n"
"the first strike.$"
msgstr "携带后，有时能抢先行动。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:497
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_MentalHerbDesc"
msgid ""
"A hold item that snaps POKéMON out\n"
"of infatuation.$"
msgstr ""
"携带后，能让宝可梦\n"
"从着迷状态中清醒过来。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:501
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_BrightpowderDesc"
msgid ""
"A hold item that casts a glare to\n"
"reduce accuracy.$"
msgstr ""
"携带后，能发出耀眼的光芒\n"
"降低对手的命中率。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:505
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_ChoiceBandDesc"
msgid ""
"Raises a move's power, but permits\n"
"only that move.$"
msgstr ""
"招式威力提高，\n"
"但只能使用那一个招式。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:509
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_KingsRockDesc"
msgid ""
"A hold item that may cause flinching\n"
"when the foe is hit.$"
msgstr ""
"携带后，攻击对手时\n"
"有时会让对手畏缩。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:513
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_FocusBandDesc"
msgid ""
"A hold item that occasionally\n"
"prevents fainting.$"
msgstr ""
"携带后，有时能撑住\n"
"不会濒死。$"

#: data/maps/BattleFrontier_ExchangeServiceCorner/scripts.inc:517
msgctxt "BattleFrontier_ExchangeServiceCorner_Text_ScopeLensDesc"
msgid ""
"A hold item that raises the\n"
"critical-hit rate.$"
msgstr ""
"携带后，能提高\n"
"击中要害的几率。$"
