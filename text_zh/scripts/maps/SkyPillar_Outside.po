#: data/maps/SkyPillar_Outside/scripts.inc:139
msgctxt "SkyPillar_Outside_Text_DoorIsClosed"
msgid "The door is closed.$"
msgstr "门关着。$"

#: data/maps/SkyPillar_Outside/scripts.inc:142
msgctxt "SkyPillar_Outside_Text_OpenedDoorToSkyPillar"
msgid ""
"WALLACE: Oh, my, I'm terribly sorry!\p"
"In my haste, I didn't notice that\n"
"I'd left you behind!\p"
"I've opened the locked door of\n"
"the SKY PILLAR.\p"
"{PLAYER}{KUN}, let's be on our way!$"
msgstr ""
"米可利：哎呀，真是太抱歉了！\p"
"我太着急了，\n"
"都没注意到把你落在后面了！\p"
"我已经打开了\n"
"天空柱上锁的门。\p"
"{PLAYER}{KUN}，我们走吧！$"

#: data/maps/SkyPillar_Outside/scripts.inc:150
msgctxt "SkyPillar_Outside_Text_EarthquakeNotMomentToWaste"
msgid ""
"WALLACE: It's an earthquake!\p"
"There's not a moment to waste!\n"
"We've got to hurry!$"
msgstr ""
"米可利：是地震！\p"
"一刻也不能耽误了！\n"
"我们得赶快！$"

#: data/maps/SkyPillar_Outside/scripts.inc:155
msgctxt "SkyPillar_Outside_Text_SituationGettingWorse"
msgid ""
"WALLACE: Hmm…\n"
"The situation is getting worse…$"
msgstr ""
"米可利：嗯……\n"
"情况越来越糟了……$"

#: data/maps/SkyPillar_Outside/scripts.inc:159
msgctxt "SkyPillar_Outside_Text_GotToGoBackForSootopolis"
msgid ""
"WALLACE: This isn't good…\p"
"The weather distortion is spreading\n"
"even here…\p"
"{PLAYER}{KUN}.\p"
"RAYQUAZA should be farther up\n"
"from here.\p"
"I'm worried about SOOTOPOLIS.\n"
"I've got to go back.\p"
"Everything is in your hands now.\n"
"Don't fail us!$"
msgstr ""
"米可利：这可不妙……\p"
"天气的异常\n"
"连这里都波及到了……\p"
"{PLAYER}{KUN}。\p"
"烈空坐应该就在\n"
"这里的更上面。\p"
"我很担心琉璃市。\n"
"我得回去了。\p"
"现在一切都交给你了。\n"
"别让我们失望！$"
