#: data/maps/SootopolisCity_Mart/scripts.inc:55
msgctxt "SootopolisCity_Mart_Text_PPUpIsGreat"
msgid ""
"PP UP is great!\p"
"It raises the POWER POINTS, the PP,\n"
"of a POKéMON move.$"
msgstr ""
"PP提升剂太棒了！\p"
"它能提高宝可梦招式的\n"
"招式点数，也就是PP。$"

#: data/maps/SootopolisCity_Mart/scripts.inc:60
msgctxt "SootopolisCity_Mart_Text_TooScaryOutside"
msgid ""
"What…\n"
"What is happening?\p"
"I really want to know, but it's too\n"
"scary to go outside.$"
msgstr ""
"发……\n"
"发生什么事了？\p"
"我真的很想知道，\n"
"可是出去太可怕了。$"

#: data/maps/SootopolisCity_Mart/scripts.inc:66
msgctxt "SootopolisCity_Mart_Text_FullRestoreItemOfDreams"
msgid ""
"Do you know FULL RESTORE?\p"
"Full restoration of HP!\n"
"Eradication of all status problems!\p"
"It's truly an item of your dreams!$"
msgstr ""
"你知道全复药吗？\p"
"HP完全恢复！\n"
"所有异常状态全部消除！\p"
"真是梦寐以求的道具啊！$"

#: data/maps/SootopolisCity_Mart/scripts.inc:72
msgctxt "SootopolisCity_Mart_Text_DidSomethingAwaken"
msgid ""
"This weather…\n"
"Did something awaken?$"
msgstr ""
"这种天气……\n"
"是有什么东西苏醒了吗？$"
