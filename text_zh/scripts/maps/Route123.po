#: data/maps/Route123/scripts.inc:173
msgctxt "Route123_Text_LoveGrassMonsHaveAny"
msgid ""
"I love GRASS-type POKéMON!\p"
"Do you have any GRASS-type POKéMON?$"
msgstr ""
"我最喜欢草属性的宝可梦了！\p"
"你有草属性的宝可梦吗？$"

#: data/maps/Route123/scripts.inc:177
msgctxt "Route123_Text_YouLikeGrassMonsTooHaveThis"
msgid ""
"Oh?\p"
"You like GRASS-type POKéMON, too,\n"
"don't you?\p"
"I'm so happy, you can have this!\n"
"It's a token of our friendship.$"
msgstr ""
"哦？\p"
"你也喜欢草属性的宝可梦，\n"
"对吧？\p"
"我好开心，这个送给你！\n"
"这是我们友谊的证明。$"

#: data/maps/Route123/scripts.inc:184
msgctxt "Route123_Text_CheckTreesWithMyGrassMon"
msgid ""
"I check trees with my GRASS-type\n"
"POKéMON. I'm like a tree doctor.$"
msgstr ""
"我和我的草属性宝可梦\n"
"一起给树木做检查。我就像树医生。$"

