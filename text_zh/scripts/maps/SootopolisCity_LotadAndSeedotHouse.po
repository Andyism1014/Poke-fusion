#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:106
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_PleaseShowMeBigSeedot"
msgid ""
"Do you know the POKéMON SEEDOT?\n"
"It's hardly ever seen in SOOTOPOLIS.\p"
"Anyway, I love big SEEDOT.\n"
"The bigger the better.\p"
"But my younger brother, he says that\n"
"LOTAD is bigger.\p"
"That's silly.\n"
"SEEDOT has to be bigger than that!\p"
"Huh? Do you have a SEEDOT with you?\n"
"P-p-please, show me!$"
msgstr ""
"你知道一种叫橡实果的宝可梦吗？\n"
"在琉璃市几乎看不到。\p"
"总之，我最喜欢大的橡实果了。\n"
"越大越好。\p"
"可是我弟弟说\n"
"莲叶童子更大。\p"
"太傻了。\n"
"橡实果一定比它大！\p"
"咦？你带着橡实果吗？\n"
"请、请、请给我看看！$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:118
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_GoshMightBeBiggerThanLotad"
msgid ""
"{STR_VAR_2}!\n"
"Oh, my gosh, this is a big one!\p"
"It might even beat the big LOTAD\n"
"my younger brother saw!\p"
"Thanks for showing me.\n"
"This is my thanks!$"
msgstr ""
"{STR_VAR_2}！\n"
"哇，好大的一只！\p"
"说不定比我弟弟见过的\n"
"那只大莲叶童子还大！\p"
"谢谢你给我看。\n"
"这是我的谢礼！$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:127
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_ReceivedPotion1"
msgid "{PLAYER} received a POTION.$"
msgstr "{PLAYER}得到了伤药。$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:130
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_BagCrammedFull1"
msgid ""
"Hunh?\n"
"Your BAG is crammed full.$"
msgstr ""
"嗯？\n"
"你的包包塞满了。$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:134
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_SeenBiggerSeedot"
msgid ""
"{STR_VAR_2}, is it?\p"
"Hmm… I've seen a bigger SEEDOT\n"
"than this one.$"
msgstr ""
"{STR_VAR_2}吗？\p"
"嗯……我见过\n"
"比这只更大的橡实果。$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:139
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_ThatsNotSeedot"
msgid ""
"Oh, now this is quite something…\n"
"But it's not a SEEDOT!$"
msgstr ""
"哦，这个真不得了……\n"
"但它不是橡实果啊！$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:143
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_DontHaveBigSeedot"
msgid ""
"You don't have a big SEEDOT?\n"
"That's too bad…\p"
"If you get a big SEEDOT, please\n"
"come show me.$"
msgstr ""
"你没有大的橡实果吗？\n"
"真可惜……\p"
"如果你得到了大的橡实果，\n"
"请拿来给我看看。$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:149
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_BiggestSeedotInHistory"
msgid ""
"The biggest SEEDOT in history!\n"
"{STR_VAR_2}'s {STR_VAR_3} giant!\p"
"A SEEDOT bigger than a LOTAD\n"
"always wanted!$"
msgstr ""
"史上最大的橡实果！\n"
"{STR_VAR_2}的{STR_VAR_3}巨无霸！\p"
"一直梦寐以求的、\n"
"比莲叶童子还大的橡实果！$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:155
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_PleaseShowMeBigLotad"
msgid ""
"Do you know the POKéMON LOTAD?\n"
"It's rarely seen in SOOTOPOLIS.\p"
"I love, I mean love, big LOTAD!\p"
"My big brother says that SEEDOT is\n"
"bigger.\p"
"But that's wrong! Everyone knows that\n"
"LOTAD is a lot bigger.\p"
"Hunh? Do you have a LOTAD?\n"
"P-p-please show me!$"
msgstr ""
"你知道一种叫莲叶童子的宝可梦吗？\n"
"在琉璃市很少见。\p"
"我最喜欢、超级喜欢大的莲叶童子了！\p"
"我哥哥说\n"
"橡实果更大。\p"
"可是他错了！大家都知道\n"
"莲叶童子要大得多。\p"
"咦？你有莲叶童子吗？\n"
"请、请、请给我看看！$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:166
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_WowMightBeBiggerThanSeedot"
msgid ""
"{STR_VAR_2}!\n"
"Wow, that is big!\p"
"It might be even bigger than the huge\n"
"SEEDOT my big brother saw.\p"
"Thanks for showing me!\n"
"This is my thanks!$"
msgstr ""
"{STR_VAR_2}！\n"
"哇，好大啊！\p"
"说不定比我哥哥见过的\n"
"那只巨大的橡实果还大。\p"
"谢谢你给我看！\n"
"这是我的谢礼！$"

