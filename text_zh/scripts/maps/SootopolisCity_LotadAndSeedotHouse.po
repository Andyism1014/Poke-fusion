#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:182
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_SeenBiggerLotad"
msgid ""
"{STR_VAR_2}?\p"
"Hmm… I've seen a bigger LOTAD\n"
"than this one here.$"
msgstr ""
"{STR_VAR_2}？\p"
"嗯……我见过\n"
"比这只更大的莲叶童子。$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:187
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_ThatsNotLotad"
msgid ""
"Well, isn't this something!\n"
"But it's no LOTAD!$"
msgstr ""
"哎呀，这个真了不起！\n"
"但它不是莲叶童子啊！$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:191
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_DontHaveBigLotad"
msgid ""
"Don't you have a big LOTAD?\n"
"How disappointing…\p"
"If you get a big LOTAD, please\n"
"come show me!$"
msgstr ""
"你没有大的莲叶童子吗？\n"
"真让人失望……\p"
"如果你得到了大的莲叶童子，\n"
"请拿来给我看看！$"

#: data/maps/SootopolisCity_LotadAndSeedotHouse/scripts.inc:197
msgctxt "SootopolisCity_LotadAndSeedotHouse_Text_BiggestLotadInHistory"
msgid ""
"The biggest LOTAD in history!\n"
"{STR_VAR_2}'s {STR_VAR_3} colossus!\p"
"A LOTAD bigger than a SEEDOT\n"
"always wanted!$"
msgstr ""
"史上最大的莲叶童子！\n"
"{STR_VAR_2}的{STR_VAR_3}庞然大物！\p"
"一直梦寐以求的、\n"
"比橡实果还大的莲叶童子！$"
