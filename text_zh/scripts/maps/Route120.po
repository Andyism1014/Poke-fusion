#: data/maps/Route120/scripts.inc:362
msgctxt "Route120_Text_StevenGreeting"
msgid ""
"STEVEN: Hm? {PLAYER}{KUN}, hi.\n"
"It's been a while.\p"
"There's something here that you can't\n"
"see, right?\p"
"Now, if I were to use this device on\n"
"the invisible obstacle…\p"
"No, no. Rather than describing it,\n"
"I should just show you.\l"
"That would be more fun.\p"
"{PLAYER}{KUN}, are your POKéMON ready for\n"
"battle?$"
msgstr ""

#: data/maps/Route120/scripts.inc:375
msgctxt "Route120_Text_StevenIllWaitHere"
msgid ""
"STEVEN: No?\p"
"I'll wait here, so you can get ready.$"
msgstr ""

#: data/maps/Route120/scripts.inc:379
