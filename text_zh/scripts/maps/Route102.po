#: data/maps/Route102/scripts.inc:76
msgctxt "Route102_Text_WatchMeCatchPokemon"
msgid ""
"WALLY: {PLAYER}…\n"
"POKéMON hide in tall grass like this,\l"
"don't they?\p"
"Please watch me and see if I can\n"
"catch one properly.\p"
"…Whoa!$"
msgstr ""
"满充：{PLAYER}……\n"
"宝可梦就藏在这样的草丛里，\l"
"对吧？\p"
"请你看着我，\n"
"看我能不能好好捉到一只。\p"
"……哇！$"

#: data/maps/Route102/scripts.inc:84
msgctxt "Route102_Text_WallyIDidIt"
msgid ""
"WALLY: I did it… It's my…\n"
"My POKéMON!$"
msgstr ""
"满充：我做到了……这是我的……\n"
"我的宝可梦！$"

#: data/maps/Route102/scripts.inc:88
msgctxt "Route102_Text_LetsGoBack"
msgid ""
"{PLAYER}, thank you!\n"
"Let's go back to the GYM!$"
msgstr ""
"{PLAYER}，谢谢你！\n"
"我们回道馆吧！$"

#: data/maps/Route102/scripts.inc:92
msgctxt "Route102_Text_ImNotVeryTall"
msgid ""
"I'm…not very tall, so I sink right\n"
"into tall grass.\p"
"The grass goes up my nose and…\n"
"Fwafwafwafwafwa…\p"
"Fwatchoo!$"
msgstr ""
"我……个子不高，\n"
"一走进草丛就会被淹没。\p"
"草会钻进鼻子里……\n"
"哈……哈……哈……\p"
"哈啾！$"

#: data/maps/Route102/scripts.inc:99
msgctxt "Route102_Text_CatchWholeBunchOfPokemon"
msgid ""
"I'm going to catch a whole bunch of\n"
"POKéMON!$"
msgstr "我要捉好多好多宝可梦！$"

