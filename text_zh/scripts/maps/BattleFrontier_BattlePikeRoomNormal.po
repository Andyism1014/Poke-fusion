#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:636
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_WillRestoreToFullHealth"
msgid ""
"Welcome…\n"
"You must be commended for your luck…\p"
"Your POKéMON shall be restored\n"
"to full health…$"
msgstr ""
"欢迎……\n"
"你的运气真值得称赞……\p"
"你的宝可梦\n"
"将会恢复健康……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:642
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_EnjoyRestOfChallenge"
msgid ""
"I urge you to enjoy the rest of your\n"
"Battle Choice challenge…$"
msgstr ""
"请尽情享受\n"
"接下来的对战抉择挑战……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:646
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_WillRestoreOneMon"
msgid ""
"Ah, you're a lucky one.\n"
"I'm in somewhat-good spirits now.\p"
"I will restore one of your POKéMON\n"
"to full health.$"
msgstr ""
"啊，你真幸运。\n"
"我现在心情还不错。\p"
"我会让你的1只宝可梦\n"
"恢复健康。$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:652
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_BestOfLuckFarewell"
msgid ""
"The best of luck to you.\n"
"Farewell.$"
msgstr ""
"祝你好运。\n"
"再见。$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:659
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_CareForBattleWillRestoreMons"
msgid ""
"Excuse me…\p"
"Would you care for a battle?\n"
"I'll restore your POKéMON if you win.$"
msgstr ""
"打扰一下……\p"
"要不要来对战？\n"
"如果你赢了，我就让你的宝可梦恢复。$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:665
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_NowShallWe"
msgid ""
"Very well…\n"
"Now, shall we?$"
msgstr ""
"很好……\n"
"那么，我们开始吧？$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:670
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_HowUnsportingOfYou"
msgid ""
"I see…\n"
"How unsporting of you…$"
msgstr ""
"原来如此……\n"
"你真没有体育精神……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:675
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_WillRestoreMonsAsPromised"
msgid ""
"Magnificent…\p"
"As promised, I shall restore your\n"
"POKéMON to full health.$"
msgstr ""
"太精彩了……\p"
"按照约定，我会让你的宝可梦\n"
"恢复健康。$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:681
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_BestOfLuckFarewell2"
msgid ""
"The best of luck to you.\n"
"Farewell.$"
msgstr ""
"祝你好运。\n"
"再见。$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:685
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_WatchOut"
msgid ""
"Oh, my!\p"
"Watch out!$"
msgstr ""
"哎呀！\p"
"小心！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:689
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_KirliaStop"
msgid ""
"Now, now!\n"
"KIRLIA, stop that!$"
msgstr ""
"好了，好了！\n"
"奇鲁莉安，快住手！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:693
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_DusclopsStop"
msgid ""
"Now, now!\n"
"DUSCLOPS, stop that!$"
msgstr ""
"好了，好了！\n"
"彷徨夜灵，快住手！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:697
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_KirliaUsedToxic"
msgid "KIRLIA used TOXIC!$"
msgstr "奇鲁莉安使出了剧毒！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:700
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_KirliaUsedHypnosis"
msgid "KIRLIA used HYPNOSIS!$"
msgstr "奇鲁莉安使出了催眠术！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:703
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_KirliaUsedThunderWave"
msgid "KIRLIA used THUNDER WAVE!$"
msgstr "奇鲁莉安使出了电磁波！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:706
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_KirliaUsedWillOWisp"
msgid "KIRLIA used WILL-O-WISP!$"
msgstr "奇鲁莉安使出了鬼火！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:709
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_DusclopsUsedWillOWisp"
msgid "DUSCLOPS used WILL-O-WISP!$"
msgstr "彷徨夜灵使出了鬼火！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:712
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_DusclopsUsedIceBeam"
msgid "DUSCLOPS used ICE BEAM!$"
msgstr "彷徨夜灵使出了冰冻光束！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:715
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_ThatsEnough"
msgid ""
"Look here!\n"
"That's quite enough!$"
msgstr ""
"喂！\n"
"够了！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:719
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_ApologizeForKirlia"
msgid ""
"I must apologize to you…\p"
"My KIRLIA has a TIMID nature…$"
msgstr ""
"我必须向你道歉……\p"
"我的奇鲁莉安是胆小的性格……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:723
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_ApologizeForDusclops"
msgid ""
"I must apologize to you…\p"
"My DUSCLOPS has a TIMID nature…$"
msgstr ""
"我必须向你道歉……\p"
"我的彷徨夜灵是胆小的性格……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:727
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_AttacksWhenStartled"
msgid ""
"It attacks without warning if it is\n"
"startled by another person…\p"
"Are you and your POKéMON all right?$"
msgstr ""
"它被别人吓到的时候，\n"
"就会毫无预兆地发动攻击……\p"
"你和你的宝可梦都没事吧？$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:732
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_ApologizeHopeMonsAreFine"
msgid ""
"I do apologize for what happened…\n"
"I do hope your POKéMON are fine.$"
msgstr ""
"刚才的事真是对不起……\n"
"希望你的宝可梦没事。$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:736
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_Silence"
msgid ""
"… … … … … …\n"
"… … … … … …$"
msgstr ""
"…… …… …… …… …… ……\n"
"…… …… …… …… …… ……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:740
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_BattleSomewhatToughTrainer"
msgid ""
"Welcome…\p"
"Here, we will have you battle\n"
"a somewhat-tough TRAINER…$"
msgstr ""
"欢迎……\p"
"在这里，你要和一位\n"
"有点厉害的训练家对战……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:745
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_RestoreToFullHealth"
msgid ""
"How wonderful…\p"
"To honor your victory, your POKéMON\n"
"shall be restored to full health…$"
msgstr ""
"太棒了……\p"
"为了表彰你的胜利，\n"
"你的宝可梦将会恢复健康……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:750
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_EnjoyRestOfChallenge2"
msgid ""
"I urge you to enjoy the rest of your\n"
"Battle Choice challenge…$"
msgstr ""
"请尽情享受\n"
"接下来的对战抉择挑战……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:754
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_ImThePikeQueen"
msgid ""
"I am LUCY…\n"
"I am the law here…\l"
"For I am the PIKE QUEEN…\p"
"You already know it, but to advance,\n"
"you must defeat me…\p"
"…I'm not one for idle chatter.\n"
"Hurry. Come on…$"
msgstr ""
"我是小蓟……\n"
"在这里，我就是规矩……\l"
"因为我是管道女王……\p"
"你应该已经知道了，\n"
"要前进，就必须打败我……\p"
"……我不喜欢闲聊。\n"
"快点。来吧……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:763
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_HopeYouDidntUseUpLuck"
msgid ""
"Your luck…\n"
"I hope you didn't use it all up here…$"
msgstr ""
"你的运气……\n"
"希望你没有在这里全部用光……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:767
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_LucyShowMeFrontierPass"
msgid ""
"LUCY: … … … … … …\n"
"Show me your FRONTIER PASS…$"
msgstr ""
"小蓟：…… …… …… …… …… ……\n"
"把你的开拓通行证给我看看……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:771
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_ReceivedLuckSymbol"
msgid ""
"The Luck Symbol was embossed on\n"
"the FRONTIER PASS!$"
msgstr ""
"开拓通行证上\n"
"印上了运气标志！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:775
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_AllThereIsDisappear"
msgid ""
"…That's all there is…\n"
"Disappear already…$"
msgstr ""
"……就这样了……\n"
"快点消失吧……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:779
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_LucyYouAgain"
msgid ""
"LUCY: …You again…\p"
"… … … … … …\p"
"…I've trampled flowers and braved\n"
"storms to get to where I am…\p"
"I don't feel any compulsion to keep\n"
"losing to the same opponent…\p"
"… … … … … …\n"
"Fine… I'll do it…$"
msgstr ""
"小蓟：……又是你……\p"
"…… …… …… …… …… ……\p"
"……我是踏过鲜花、闯过风暴\n"
"才走到今天的……\p"
"我可不想一直\n"
"输给同一个对手……\p"
"…… …… …… …… …… ……\n"
"好吧……我来……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:789
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_NowComeOn"
msgid ""
"Now!\n"
"Come on!$"
msgstr ""
"来吧！\n"
"上吧！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:793
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_LucyFrontierPass"
msgid ""
"LUCY: … … … … … …\p"
"…FRONTIER PASS…$"
msgstr ""
"小蓟：…… …… …… …… …… ……\p"
"……开拓通行证……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:797
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_LuckSymbolTookGoldenShine"
msgid ""
"The Luck Symbol took on\n"
"a golden shine!$"
msgstr ""
"运气标志\n"
"发出了金色的光芒！$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:801
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_IWontForget"
msgid ""
"…You, I won't forget…\n"
"…Ever…$"
msgstr ""
"……你，我不会忘记的……\n"
"……永远……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:805
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_ChoseRoomNoHeal"
msgid ""
"I welcome you…\p"
"Giggle…\n"
"You seem to be bereft of luck…\p"
"If only you hadn't chosen this room,\n"
"your POKéMON could have been healed…$"
msgstr ""
"欢迎你……\p"
"嘻嘻……\n"
"你好像没什么运气呢……\p"
"要是你没选这个房间，\n"
"你的宝可梦就能得到回复了……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:812
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_ChoseRoomHealOne"
msgid ""
"I welcome you…\p"
"Since you have chosen this room, I will\n"
"restore one POKéMON to full health…$"
msgstr ""
"欢迎你……\p"
"既然你选择了这个房间，\n"
"我会让1只宝可梦恢复健康……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:817
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_ChoseRoomHealTwo"
msgid ""
"I welcome you…\p"
"Since you have chosen this room, I will\n"
"restore two POKéMON to full health…$"
msgstr ""
"欢迎你……\p"
"既然你选择了这个房间，\n"
"我会让2只宝可梦恢复健康……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:823
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_WillRestoreAllMons"
msgid ""
"I welcome you…\p"
"Giggle…\n"
"You should thank your lucky stars…\p"
"Since you have chosen this room,\n"
"all your POKéMON will be restored…$"
msgstr ""
"欢迎你……\p"
"嘻嘻……\n"
"你应该感谢你的好运……\p"
"既然你选择了这个房间，\n"
"你所有的宝可梦都会恢复……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:830
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_ShallFetchOurMaster"
msgid "I shall go fetch our master…$"
msgstr "我这就去请我们的主人……$"

#: data/maps/BattleFrontier_BattlePikeRoomNormal/scripts.inc:833
msgctxt "BattleFrontier_BattlePikeRoomNormal_Text_WillRestoreTwoMons"
msgid ""
"Ah, you're a lucky one!\n"
"I'm in good spirits now.\p"
"I will restore two of your POKéMON\n"
"to full health!$"
msgstr ""
"啊，你真幸运！\n"
"我现在心情很好。\p"
"我会让你的2只宝可梦\n"
"恢复健康！$"
