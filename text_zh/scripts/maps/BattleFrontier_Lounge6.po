#: data/maps/BattleFrontier_Lounge6/scripts.inc:29
msgctxt "BattleFrontier_Lounge6_Text_WouldYouLikeToTrade"
msgid ""
"My POKéMON is a {STR_VAR_2}.\n"
"Do you know it?\l"
"It's quite cute and rather nice.\p"
"This little one, I could trade with\n"
"pride!\p"
"Would you like to trade me a {STR_VAR_1}\n"
"for my {STR_VAR_2}?$"
msgstr ""
"我的宝可梦是{STR_VAR_2}。\n"
"你知道它吗？\l"
"它非常可爱，性格也很好。\p"
"这个小家伙，我可以\n"
"骄傲地拿出来交换！\p"
"你愿意用{STR_VAR_1}\n"
"来换我的{STR_VAR_2}吗？$"

#: data/maps/BattleFrontier_Lounge6/scripts.inc:38
msgctxt "BattleFrontier_Lounge6_Text_PromiseIllBeGoodToIt"
msgid ""
"Oh, it's adorable!\n"
"Thank you!\l"
"I promise I'll be good to it!\p"
"Oh! I hope you'll be good to\n"
"my {STR_VAR_2}, too!$"
msgstr ""
"哎呀，好可爱！\n"
"谢谢你！\l"
"我保证会好好待它的！\p"
"啊！希望你也能\n"
"好好对待我的{STR_VAR_2}！$"

#: data/maps/BattleFrontier_Lounge6/scripts.inc:45
msgctxt "BattleFrontier_Lounge6_Text_DontTradeForAnythingButMon"
msgid ""
"Oh, I'm sorry!\n"
"I don't intend to trade for anything\l"
"but a {STR_VAR_1}.$"
msgstr ""
"哎呀，不好意思！\n"
"除了{STR_VAR_1}以外，\l"
"我不打算换别的。$"

#: data/maps/BattleFrontier_Lounge6/scripts.inc:50
msgctxt "BattleFrontier_Lounge6_Text_WellThatsFineToo"
msgid ""
"Oh, you won't?\n"
"Well, that's fine, too.\l"
"Please come visit us again.$"
msgstr ""
"哦，你不愿意吗？\n"
"嗯，那也没关系。\l"
"欢迎再来玩。$"

#: data/maps/BattleFrontier_Lounge6/scripts.inc:55
msgctxt "BattleFrontier_Lounge6_Text_SkittySoMuchCuterThanImagined"
msgid ""
"Giggle!\n"
"A SKITTY is so much cuter than I had\l"
"imagined. I'm delighted!$"
msgstr ""
"嘻嘻！\n"
"向尾喵比我想象的还要可爱。\l"
"我太高兴了！$"
