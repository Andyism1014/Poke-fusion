#: data/maps/Route109_SeashoreHouse/scripts.inc:104
msgctxt "Route109_SeashoreHouse_Text_SeashoreHouseIntro"
msgid ""
"I'm the owner of the SEASHORE HOUSE.\n"
"But you can call me MR. SEA!\p"
"What I love above all is to see hot\n"
"POKéMON battles.\p"
"Let me see that your heart burns hot!\p"
"If you can defeat all the TRAINERS\n"
"here, I'll reward your efforts.$"
msgstr ""

#: data/maps/Route109_SeashoreHouse/scripts.inc:113
msgctxt "Route109_SeashoreHouse_Text_ShowMeSomeHotMatches"
msgid ""
"Show me some hot matches!\p"
"I run this SEASHORE HOUSE just for\n"
"that reason alone!$"
msgstr ""

#: data/maps/Route109_SeashoreHouse/scripts.inc:118
msgctxt "Route109_SeashoreHouse_Text_TakeTheseSodaPopBottles"
msgid ""
"You're scorching hot!\n"
"Those battles blazed!\l"
"I'm more than just satisfied!\p"
"As thanks for showing me your hot\n"
"streak, I want you to take these.\p"
"It's half a dozen bottles of SODA POP!$"
msgstr ""

#: data/maps/Route109_SeashoreHouse/scripts.inc:126
msgctxt "Route109_SeashoreHouse_Text_BagFull"
msgid ""
"Oh, but hey, your BAG's jammed full.\n"
"I'll hang on to these for you.$"
msgstr ""

#: data/maps/Route109_SeashoreHouse/scripts.inc:130
msgctxt "Route109_SeashoreHouse_Text_WantToBuySodaPop"
msgid ""
"Want to buy some SODA POP?\n"
"POKéMON love it!\p"
"Just ¥300 a bottle!\n"
"Buy some!$"
msgstr ""

#: data/maps/Route109_SeashoreHouse/scripts.inc:136
msgctxt "Route109_SeashoreHouse_Text_HereYouGo"
msgid "Here you go!$"
msgstr ""

#: data/maps/Route109_SeashoreHouse/scripts.inc:139
