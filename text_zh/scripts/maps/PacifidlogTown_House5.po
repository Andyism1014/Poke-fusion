#: data/maps/PacifidlogTown_House5/scripts.inc:29
msgctxt "PacifidlogTown_House5_Text_MirageIslandAppearDependingOnWeather"
msgid ""
"MIRAGE ISLAND…\p"
"It must become visible and invisible\n"
"depending on the weather conditions\l"
"that make mirages appear.\p"
"Or is it really appearing and\n"
"disappearing?$"
msgstr ""
"幻影岛……\p"
"它一定是随着产生海市蜃楼的\n"
"天气条件，时隐时现的吧。\p"
"还是说，它真的会\n"
"出现和消失呢？$"
