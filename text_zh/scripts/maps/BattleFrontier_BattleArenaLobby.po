msgstr ""

#: data/maps/BattleFrontier_BattleArenaLobby/scripts.inc:472
msgctxt "BattleFrontier_BattleArenaLobby_Text_ThankYouWaitWhileSave"
msgid ""
"Thank you so much for participating!\p"
"Please wait while I save the game.$"
msgstr ""

#: data/maps/BattleFrontier_BattleArenaLobby/scripts.inc:476
msgctxt "BattleFrontier_BattleArenaLobby_Text_AwaitAnotherChallenge2"
msgid ""
"We await your challenge on\n"
"another occasion!$"
msgstr ""

#: data/maps/BattleFrontier_BattleArenaLobby/scripts.inc:480
