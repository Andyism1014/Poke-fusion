#: data/maps/NewMauville_Inside/scripts.inc:248
msgctxt "NewMauville_Inside_Text_GeneratorRadiatingHeat"
msgid ""
"The generator is radiating heat that\n"
"can be felt even at a distance.\p"
"It looks like it should be turned off\n"
"as soon as possible.$"
msgstr ""
"发电机散发出的热量\n"
"离得很远都能感觉到。\p"
"看来应该尽快把它关掉。$"

#: data/maps/NewMauville_Inside/scripts.inc:254
msgctxt "NewMauville_Inside_Text_GeneratorQuietedDown"
msgid "The generator quieted down.$"
msgstr "发电机安静下来了。$"

#: data/maps/NewMauville_Inside/scripts.inc:257
msgctxt "NewMauville_Inside_Text_SteppedOnSwitchGeneratorStopped"
msgid ""
"{PLAYER} stepped on the switch.\p"
"Click…\p"
"… … … … … … … …\n"
"… … … … … … … …\p"
"The generator appears to have\n"
"stopped…$"
msgstr ""
"{PLAYER}踩下了开关。\p"
"咔嚓……\p"
"…… …… …… ……\n"
"…… …… …… ……\p"
"发电机好像\n"
"停下来了……$"
