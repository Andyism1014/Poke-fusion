#: data/maps/PacifidlogTown_House3/scripts.inc:33
msgctxt "PacifidlogTown_House3_Text_WillingToTradeIt"
msgid ""
"Check out this {STR_VAR_2}!\p"
"It's the {STR_VAR_2} that I caught\n"
