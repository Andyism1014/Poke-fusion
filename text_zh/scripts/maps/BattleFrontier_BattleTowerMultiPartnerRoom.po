msgid ""
"and one {STR_VAR_2} with {STR_VAR_1},\n"
"that's my pair.\p"
"Please, will you join me in\n"
"a tag team?$"
msgstr ""
"和会{STR_VAR_1}的{STR_VAR_2}，\n"
