"我是{STR_VAR_3}。\n"
"是{STR_VAR_1}的第{STR_VAR_2}号徒弟……$"

#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom/scripts.inc:416
msgctxt "BattleFrontier_BattleTowerMultiPartnerRoom_Text_Apprentice4Mon1"
msgid ""
"{STR_VAR_3} gave me advice.\n"
"I'm very grateful for it.\p"
"I have a team of one {STR_VAR_2}\n"
"with {STR_VAR_1} and$"
msgstr ""
