#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom/scripts.inc:402
msgctxt "BattleFrontier_BattleTowerMultiPartnerRoom_Text_Apprentice3Accept"
msgid ""
"Thank you!\n"
"I'll register right away!$"
