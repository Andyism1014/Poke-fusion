"我的队伍是\n"
"会{STR_VAR_1}的{STR_VAR_2}和$"

#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom/scripts.inc:422
msgctxt "BattleFrontier_BattleTowerMultiPartnerRoom_Text_Apprentice4Mon2Ask"
msgid ""
"one {STR_VAR_2} with {STR_VAR_1}.\n"
"I know I'm asking a lot…\p"
"I don't think you'll be willing to,\n"
"but may I join you as a partner?$"
msgstr ""
"会{STR_VAR_1}的{STR_VAR_2}。\n"
