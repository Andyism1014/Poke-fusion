#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom/scripts.inc:279
msgctxt "BattleFrontier_BattleTowerMultiPartnerRoom_Text_PleaseFindPartner"
msgid ""
"Please find a partner from out of\n"
"the TRAINERS gathered here.$"
msgstr ""
"请从聚集在这里的训练家中\n"
"找一位搭档。$"

#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom/scripts.inc:283
msgctxt "BattleFrontier_BattleTowerMultiPartnerRoom_Text_QuitLookingForPartner"
msgid ""
"{PLAYER}, you have not found a partner\n"
"for your tag team.\p"
"Would you like to quit looking and\n"
"return to the reception counter?$"
msgstr ""
"{PLAYER}，你还没有找到\n"
"组队的搭档。\p"
"要放弃寻找，\n"
"回到接待柜台吗？$"

#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom/scripts.inc:289
msgctxt "BattleFrontier_BattleTowerMultiPartnerRoom_Text_PleaseFindPartner2"
msgid ""
"Then, please find a partner from\n"
"the TRAINERS gathered here.$"
msgstr ""
"那么，请从聚集在这里的\n"
"训练家中找一位搭档。$"

#: data/maps/BattleFrontier_BattleTowerMultiPartnerRoom/scripts.inc:293
