#: data/maps/OldaleTown/scripts.inc:346
msgctxt "OldaleTown_Text_IWorkAtPokemonMart"
msgid ""
"Hi!\n"
"I work at a POKéMON MART.\p"
"Can I get you to come with me?$"
msgstr ""

#: data/maps/OldaleTown/scripts.inc:351
msgctxt "OldaleTown_Text_ThisIsAPokemonMart"
msgid ""
"This is a POKéMON MART.\n"
"Just look for our blue roof.\p"
"We sell a variety of goods including\n"
"POKé BALLS for catching POKéMON.\p"
"Here, I'd like you to have this as\n"
"a promotional item.$"
msgstr ""

#: data/maps/OldaleTown/scripts.inc:359
msgctxt "OldaleTown_Text_PotionExplanation"
msgid ""
"A POTION can be used anytime, so it's\n"
"even more useful than a POKéMON CENTER\l"
"in certain situations.$"
msgstr ""

#: data/maps/OldaleTown/scripts.inc:364
msgctxt "OldaleTown_Text_WaitDontComeInHere"
msgid ""
