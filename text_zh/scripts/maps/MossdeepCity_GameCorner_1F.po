#: data/maps/MossdeepCity_GameCorner_1F/scripts.inc:57
msgctxt "RS_MysteryEventsHouse_Text_YouWontBattle"
msgid ""
"You won't battle? I'm disappointed\n"
"that I can't see you battle…$"
msgstr ""

#: data/maps/MossdeepCity_GameCorner_1F/scripts.inc:61
msgctxt "RS_MysteryEventsHouse_Text_KeepItToA3On3"
msgid ""
