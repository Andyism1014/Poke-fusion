#: data/maps/TrainerHill_Entrance/scripts.inc:289
msgctxt "TrainerHill_Entrance_Text_StillGettingReady"
msgid ""
"This is the TRAINER HILL where\n"
"you may enjoy tag battles with many\l"
"TRAINERS.\p"
"Unfortunately, we're still getting\n"
"things ready. Please come back later!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:296
msgctxt "TrainerHill_Entrance_Text_WelcomeToTrainerHill"
msgid ""
"Welcome!\p"
"This is the TRAINER HILL where\n"
"you may enjoy tag battles with many\l"
"TRAINERS!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:302
msgctxt "TrainerHill_Entrance_Text_SaveGameBeforeEnter"
msgid ""
"Is this your first visit here?\p"
"Before you enter, please save\n"
"your game.$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:307
msgctxt "TrainerHill_Entrance_Text_TrainersUpToFloorX"
msgid ""
"Let's see…\n"
"The TRAINERS here now are…\p"
"Up to floor no. {STR_VAR_1}.$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:312
msgctxt "TrainerHill_Entrance_Text_TrainersInEveryRoom"
msgid ""
"Let's see…\n"
"The TRAINERS here now are…\p"
"There appear to be TRAINERS gathered\n"
"in every room.$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:318
msgctxt "TrainerHill_Entrance_Text_LikeToChallengeTrainers"
msgid ""
"Would you like to challenge the\n"
"waiting TRAINERS?$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:322
msgctxt "TrainerHill_Entrance_Text_TimeProgessGetSetGo"
msgid ""
"I will time your progress.\n"
"Best of luck!\p"
"On your marks…\p"
"Get set…\p"
"Go!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:329
msgctxt "TrainerHill_Entrance_Text_PleaseVisitUsAgain"
msgid "Please do visit us again!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:332
msgctxt "TrainerHill_Entrance_Text_TooBadTremendousEffort"
msgid ""
"That was too bad.\p"
"I think you put in a tremendous\n"
"effort in your battling.\p"
"Please come back and try again!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:338
msgctxt "TrainerHill_Entrance_Text_HopeYouGiveItYourBest"
msgid "I hope you give it your best.$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:341
msgctxt "TrainerHill_Entrance_Text_MovedReceptionHereForSwitch"
msgid ""
"When the TRAINERS switch places,\n"
"the movement can be hectic.\p"
"To avoid the stampede, we moved\n"
"the reception counter here.\p"
"I'm sorry for the inconvenience.$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:348
msgctxt "TrainerHill_Entrance_Text_ThankYouForPlaying"
msgid "Thank you for playing!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:351
msgctxt "TrainerHill_Entrance_Text_ExplainTrainerHill"
msgid ""
"Here at the TRAINER HILL, we conduct\n"
"an event called the Time Attack.\p"
"It is a race that measures how long\n"
"you take to reach our owner on\l"
"the rooftop from this counter.\p"
"The fastest times are posted on\n"
"the Time Board--try competing with\l"
"your friends.\p"
"In TRAINER battles along the way,\n"
"neither Exp. Points nor money will\l"
"be awarded.$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:365
msgctxt "TrainerHill_Entrance_Text_NeedAtLeastTwoPokemon"
msgid ""
"Oh, I'm sorry, but you appear to have\n"
"only one POKéMON with you.\p"
"You will need at least two POKéMON\n"
"to enter this event.$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:371
msgctxt "TrainerHill_Roof_Text_YouFinallyCameBravo"
msgid ""
"Hm! Hm!\p"
"You finally came!\n"
"Yes, you have arrived!\p"
"Wait! Don't say it!\n"
"I know why you came all the way\l"
"here by yourself!\p"
"You wanted to see me, the owner\n"
"of the TRAINER HILL, because…\p"
"You want to form a tag team with me!\n"
"Wa-hoo!\p"
"…Uh?\n"
"That's not it?\p"
"Anyway, I watched you on your way up.\n"
"Marvelous battling! Bravo, indeed!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:387
msgctxt "TrainerHill_Roof_Text_HaveTheMostMarvelousGift"
msgid ""
"For a marvelous someone like you,\n"
"I have the most marvelous gift!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:391
msgctxt "TrainerHill_Roof_Text_FullUpBeBackLaterForThis"
msgid ""
"Oh, no, full up with things!\n"
"You'll be back later for this!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:395
msgctxt "TrainerHill_Roof_Text_GotHereMarvelouslyQuickly"
msgid ""
"Oh, hold on here! Did you possibly get\n"
"here marvelously quickly?\p"
"How splendid! You needn't have\n"
"hurried so to see me!\p"
"That is so delightful. I'll have the Time\n"
"Board at the reception updated!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:403
msgctxt "TrainerHill_Roof_Text_YouWerentVeryQuick"
msgid ""
"But, oh…\n"
"You weren't very quick getting here.$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:407
msgctxt "TrainerHill_Roof_Text_ArriveZippierNextTime"
msgid ""
"Perhaps it would please me more if you\n"
"arrived zippier next time.\p"
"Then, I should be pleased to form\n"
"a tag team with you!\p"
"Until we meet again, amigo!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:415
msgctxt "TrainerHill_Roof_Text_BuiltTrainerHillToFindPartner"
msgid ""
"I had the TRAINER HILL built for but\n"
"one reason and one only!\p"
"To find the most suitable partner\n"
"with whom I may form a tag team!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:421
msgctxt "TrainerHill_Entrance_Text_ChallengeTime"
msgid "{STR_VAR_1} min. {STR_VAR_2}.{STR_VAR_3} sec.$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:424
msgctxt "TrainerHill_Entrance_Text_WhatSortOfTrainersAreAhead"
msgid ""
"Who knows what sort of TRAINERS\n"
"and POKéMON combos are ahead?\p"
"All I know is that I'll knock aside\n"
"anyone that stands in my way!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:430
msgctxt "TrainerHill_Entrance_Text_CantWaitToTestTheWaters"
msgid ""
"I heard tough TRAINERS come to this\n"
"TRAINER HILL from all over.\p"
"I can't wait to test the waters!\p"
"I'll knock aside anyone that stands\n"
"in my way!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:437
msgctxt "TrainerHill_Entrance_Text_FriendsTryingToReachTimeBoardTop"
msgid ""
"Do you see the Time Board over there?\p"
"My friends and I are trying to see who\n"
"can reach the top in the least time.$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:442
msgctxt "TrainerHill_Entrance_Text_DoYouKnowWhenTheyOpen"
msgid ""
"Do you know when they're opening\n"
"this place up?\p"
"I'm waiting here to be the first\n"
"challenger ever!$"
msgstr ""

#: data/maps/TrainerHill_Entrance/scripts.inc:448
msgctxt "TrainerHill_Elevator_Text_ReturnToReception"
msgid ""
"Would you like to return to\n"
"the reception counter?$"
msgstr ""
