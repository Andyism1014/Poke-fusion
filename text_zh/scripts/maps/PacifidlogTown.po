#: data/maps/PacifidlogTown/scripts.inc:30
msgctxt "PacifidlogTown_Text_FastRunningCurrent"
msgid ""
"The sea between PACIFIDLOG and\n"
"SLATEPORT has a fast-running tide.\p"
"If you decide to SURF, you could end\n"
"up swept away somewhere else.$"
msgstr ""

#: data/maps/PacifidlogTown/scripts.inc:36
msgctxt "PacifidlogTown_Text_NeatHousesOnWater"
msgid ""
"See, isn't it neat?\n"
"These houses are on water!\p"
"I was born here!$"
msgstr ""

#: data/maps/PacifidlogTown/scripts.inc:41
msgctxt "PacifidlogTown_Text_SkyPillarTooScary"
msgid ""
"The SKY PILLAR?\p"
"…Oh, you must mean that tall, tall\n"
"tower a little further out.\p"
"If you asked me, I wouldn't climb it.\n"
"It's too scary to get up that high.\p"
"Life at sea level in PACIFIDLOG,\n"
"that suits me fine.$"
msgstr ""

#: data/maps/PacifidlogTown/scripts.inc:50
msgctxt "PacifidlogTown_Text_TownSign"
msgid ""
"PACIFIDLOG TOWN\p"
"“Where the morning sun smiles upon\n"
"the waters.”$"
msgstr ""
