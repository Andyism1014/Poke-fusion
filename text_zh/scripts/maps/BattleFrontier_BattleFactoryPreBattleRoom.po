#: data/maps/BattleFrontier_BattleFactoryPreBattleRoom/scripts.inc:613
msgctxt "BattleFrontier_BattleFactoryPreBattleRoom_Text_LikeToSwapMon"
msgid ""
"Before starting the battle, would you\n"
"like to swap a POKéMON?$"
msgstr ""
"开始对战之前，\n"
"你要交换宝可梦吗？$"

#: data/maps/BattleFrontier_BattleFactoryPreBattleRoom/scripts.inc:617
msgctxt "BattleFrontier_BattleFactoryPreBattleRoom_Text_YourSwapIsComplete"
msgid ""
"Thank you!\n"
"Your POKéMON swap is complete.$"
msgstr ""
"谢谢！\n"
"宝可梦的交换完成了。$"

#: data/maps/BattleFrontier_BattleFactoryPreBattleRoom/scripts.inc:621
msgctxt "BattleFrontier_BattleFactoryPreBattleRoom_Text_RightThisWay"
msgid "Right this way, please!$"
msgstr "请往这边走！$"

#: data/maps/BattleFrontier_BattleFactoryPreBattleRoom/scripts.inc:624
msgctxt "BattleFrontier_BattleFactoryPreBattleRoom_Text_SavingDataPleaseWait"
msgid ""
"I am saving your data.\n"
"Please wait.$"
msgstr ""
"正在记录数据。\n"
"请稍候。$"

#: data/maps/BattleFrontier_BattleFactoryPreBattleRoom/scripts.inc:628
msgctxt "BattleFrontier_BattleFactoryPreBattleRoom_Text_RecordLatestBattle"
msgid ""
"Would you like to record your latest\n"
"battle on your FRONTIER PASS?$"
msgstr ""
"要把你最近的一场对战\n"
"录到开拓通行证里吗？$"

#: data/maps/BattleFrontier_BattleFactoryPreBattleRoom/scripts.inc:632
msgctxt "BattleFrontier_BattleFactoryPreBattleRoom_Text_WaitFewMoments"
msgid ""
"Excuse me! Excuse me, please!\n"
"May I get you to wait a few moments?$"
msgstr ""
"不好意思！不好意思！\n"
"能请你稍等一下吗？$"

#: data/maps/BattleFrontier_BattleFactoryPreBattleRoom/scripts.inc:636
msgctxt "BattleFrontier_BattleFactoryPreBattleRoom_Text_UnderstoodSirWillDo"
msgid ""
"…Uh-huh? What?! …Whoa!\n"
"Understood, sir! Will do!$"
msgstr ""
"……嗯？什么？！……哇！\n"
"明白了！我马上去办！$"

#: data/maps/BattleFrontier_BattleFactoryPreBattleRoom/scripts.inc:640
msgctxt "BattleFrontier_BattleFactoryPreBattleRoom_Text_MessageFromHeadComeRightNow"
msgid ""
"Oh, my…\n"
"Sorry to keep you waiting!\p"
"I have a message from this facility's\n"
"boss, the FACTORY HEAD.\p"
"He says, “We're going to do it!\n"
"Come here right now!”$"
msgstr ""
"哎呀……\n"
"让你久等了！\p"
"我收到了这座设施的老板——\n"
"工厂主管的口信。\p"
"他说：“我们来比一场！\n"
"马上过来！”$"

#: data/maps/BattleFrontier_BattleFactoryPreBattleRoom/scripts.inc:648
msgctxt "BattleFrontier_BattleFactoryPreBattleRoom_Text_PreparedToFaceHead"
msgid ""
"The FACTORY HEAD is demanding you.\n"
"Are you prepared to face him?$"
msgstr ""
"工厂主管要求和你对战。\n"
"你准备好面对他了吗？$"

#: data/maps/BattleFrontier_BattleFactoryPreBattleRoom/scripts.inc:652
msgctxt "BattleFrontier_BattleFactoryPreBattleRoom_Text_CantTellAnythingAboutHead"
msgid ""
"I'm terribly sorry, but I can't tell you\n"
"anything about the FACTORY HEAD.$"
msgstr ""
"非常抱歉，关于工厂主管的事，\n"
"我什么都不能告诉你。$"
