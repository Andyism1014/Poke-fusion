#: data/maps/MauvilleCity_GameCorner/scripts.inc:629
msgctxt "MauvilleCity_GameCorner_Text_ThisIsMauvilleGameCorner"
msgid "This is MAUVILLE GAME CORNER.$"
msgstr "这里是紫堇游戏城。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:632
msgctxt "MauvilleCity_GameCorner_Text_NeedCoinCaseForCoins"
msgid ""
"Okay, you wanted some COINS for\n"
"the games?\p"
"But you don't have a COIN CASE for\n"
"stowing the COINS.$"
msgstr ""
"好的，你想要玩游戏用的代币吗？\p"
"可是你没有用来\n"
"装代币的代币盒。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:638
msgctxt "MauvilleCity_GameCorner_Text_WereYouLookingForCoins"
msgid ""
"Were you looking for COINS?\p"
"It's ¥1000 for 50 COINS.\n"
"Would you like some?$"
msgstr ""
"你是要买代币吗？\p"
"50枚代币1000元。\n"
"要买吗？$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:643
msgctxt "MauvilleCity_GameCorner_Text_ThankYouHereAreYourCoins"
msgid ""
"Thank you very much!\n"
"Here are your COINS!$"
msgstr ""
"非常感谢！\n"
"这是你的代币！$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:647
msgctxt "MauvilleCity_GameCorner_Text_DontHaveEnoughMoney"
msgid ""
"Um… You don't appear to have\n"
"enough money…$"
msgstr ""
"呃……你的钱\n"
"好像不够……$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:651
msgctxt "MauvilleCity_GameCorner_Text_CoinCaseIsFull"
msgid ""
"Oh?\n"
"Your COIN CASE is full.$"
msgstr ""
"哎呀？\n"
"你的代币盒已经满了。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:655
msgctxt "MauvilleCity_GameCorner_Text_DontNeedCoinsThen"
msgid ""
"Oh… You don't need COINS, then?\n"
"Good luck on your adventure!$"
msgstr ""
"哦……你不需要代币吗？\n"
"祝你冒险顺利！$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:659
msgctxt "MauvilleCity_GameCorner_Text_ExchangeCoinsForPrizes"
msgid ""
"Welcome.\p"
"You can exchange your COINS for\n"
"prizes here.$"
msgstr ""
"欢迎光临。\p"
"你可以在这里\n"
"用代币兑换奖品。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:664
msgctxt "MauvilleCity_GameCorner_Text_WhichPrize"
msgid "Which prize would you like?$"
msgstr "你想要哪一种奖品？$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:667
msgctxt "MauvilleCity_GameCorner_Text_SoYourChoiceIsTheTMX"
msgid ""
"So your choice is\n"
"the {STR_VAR_1} {STR_VAR_2}?$"
msgstr ""
"你要选择的是\n"
"{STR_VAR_1}{STR_VAR_2}吗？$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:671
msgctxt "MauvilleCity_GameCorner_Text_SendToYourHomePC"
msgid ""
"Thank you!\n"
"We'll send it to your PC at home.$"
msgstr ""
"谢谢！\n"
"我们会把它送到你家的电脑里。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:675
msgctxt "MauvilleCity_GameCorner_Text_NotEnoughCoins"
msgid "You don't have enough COINS.$"
msgstr "你的代币不够。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:679
msgctxt "MauvilleCity_GameCorner_Text_NoRoomForPlacingDecor"
msgid ""
"There isn't any room available for\n"
"placing {STR_VAR_1}.$"
msgstr ""
"已经没有地方\n"
"可以放{STR_VAR_1}了。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:683
msgctxt "MauvilleCity_GameCorner_Text_OhIsThatSo"
msgid ""
"Oh, is that so? \n"
"You need to save some COINS before\l"
"coming back here.$"
msgstr ""
"哦，是吗？\n"
"请攒够代币以后再来吧。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:688
msgctxt "MauvilleCity_GameCorner_Text_SoYourChoiceIsX"
msgid "So your choice is {STR_VAR_1}?$"
msgstr "你要选择的是{STR_VAR_1}吗？$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:691
msgctxt "MauvilleCity_GameCorner_Text_HereYouGo"
msgid "Here you go!$"
msgstr "给你！$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:695
msgctxt "MauvilleCity_GameCorner_Text_CantCarryAnyMore"
msgid "Oh, you can't carry any more than that.$"
msgstr "哎呀，你已经拿不下更多了。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:698
msgctxt "MauvilleCity_GameCorner_Text_GotTwoOfSameDollWantOne"
msgid ""
"I made a mistake and got two of\n"
"the same DOLLS.\p"
"Would you like one of them?$"
msgstr ""
"我不小心拿到了\n"
"两个一模一样的玩偶。\p"
"你想要其中一个吗？$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:703
msgctxt "MauvilleCity_GameCorner_Text_HereYouGo2"
msgid "Here you go!$"
msgstr "给你！$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:706
msgctxt "MauvilleCity_GameCorner_Text_YouWantItButNotNow"
msgid ""
"Huh?\n"
"You want it, but not right now?$"
msgstr ""
"咦？\n"
"你想要，但不是现在？$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:710
msgctxt "MauvilleCity_GameCorner_Text_DontBeNegative"
msgid ""
"Oh, don't be so negative!\n"
"You can have this!$"
msgstr ""
"哎呀，别这么消极嘛！\n"
"这个送给你！$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:714
msgctxt "MauvilleCity_GameCorner_Text_CantWinJackpot"
msgid ""
"There's a prize I want, but I can't win\n"
"the jackpot.$"
msgstr ""
"我有一个想要的奖品，\n"
"可是怎么也中不了大奖。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:718
msgctxt "MauvilleCity_GameCorner_Text_NeedCoinCaseGoNextDoor"
msgid ""
"Hey, kid, if you want to play here,\n"
"you need a COIN CASE.\p"
"I think the young lady next door\n"
"had one. Go see her!$"
msgstr ""
"喂，小朋友，想在这里玩的话，\n"
"你需要一个代币盒。\p"
"我记得隔壁的大姐姐有一个。\n"
"去找她吧！$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:724
msgctxt "MauvilleCity_GameCorner_Text_LuckOnlyLastSoLongTakeCoins"
msgid ""
"My luck can only last so long.\n"
"This is too much for me.\l"
"Here, take some COINS!$"
msgstr ""
"我的好运总不会一直持续下去。\n"
"这些对我来说太多了。\l"
"来，拿些代币去吧！$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:729
msgctxt "MauvilleCity_GameCorner_Text_MauvilleSomethingForEveryone"
msgid ""
"MAUVILLE has something for\n"
"everyone.\p"
"For me, it's the GAME CORNER.$"
msgstr ""
"紫堇市有能让\n"
"每个人都喜欢的东西。\p"
"对我来说，就是游戏城。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:734
msgctxt "MauvilleCity_GameCorner_Text_RouletteTablesDifferentRates"
msgid ""
"The ROULETTE tables have different\n"
"rates.\p"
"Check your COINS if you're going to\n"
"pick a table.$"
msgstr ""
"每张轮盘桌的倍率都不一样。\p"
"要选桌子的话，\n"
"先看看你有多少代币吧。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:740
msgctxt "MauvilleCity_GameCorner_Text_EasyToLoseTrackOfTime"
msgid ""
"It's easy to lose track of time in here. \n"
"I should get back to work.$"
msgstr ""
"在这里一不小心\n"
"就会忘了时间。我得回去工作了。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:744
msgctxt "MauvilleCity_GameCorner_Text_CoinsAreNeededToPlay"
msgid ""
"COINS are needed to play here\n"
"in the GAME CORNER.$"
msgstr ""
"在游戏城里玩游戏\n"
"需要代币。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:748
msgctxt "MauvilleCity_GameCorner_Text_RouletteOnlyLuck"
msgid ""
"This ROULETTE thing…\n"
"It's rather demanding.\p"
"Win or lose, it's only by luck.$"
msgstr ""
"这个轮盘啊……\n"
"还真是难搞。\p"
"输赢全都只能靠运气。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:753
msgctxt "MauvilleCity_GameCorner_Text_UpTo3CoinsCanBeUsed"
msgid ""
"Up to three COINS can be used to play\n"
"the SLOTS.$"
msgstr ""
"玩老虎机时\n"
"最多可以投入3枚代币。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:757
msgctxt "MauvilleCity_GameCorner_Text_DifficultToStopOn7"
msgid ""
"It's very difficult to make it stop\n"
"right on “7.”\p"
"If it stops on “7” during the REEL TIME\n"
"bonus game, you'll receive extra COINS.$"
msgstr ""
"要让它正好停在“7”上\n"
"是非常难的。\p"
"如果在幸运时间的奖励游戏中\n"
"停在“7”上，就能得到额外的代币。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:763
msgctxt "MauvilleCity_GameCorner_Text_HeresSomeSlotsInfo"
msgid ""
"Here's some information for you\n"
"about the SLOTS.\p"
"The more lightning bolts you stock,\n"
"the more REEL TIME chances you get.\p"
"In a game with the maximum five\n"
"REEL TIME chances…\p"
"It is possible to receive four regular\n"
"bonuses, then a big bonus.\p"
"That would total 660 COINS, but it's\n"
"very difficult to get.$"
msgstr ""
"告诉你一些\n"
"关于老虎机的情报吧。\p"
"闪电储存得越多，\n"
"就越有机会进入幸运时间。\p"
"在最多有5次\n"
"幸运时间机会的游戏里……\p"
"有可能先中4次普通奖励，\n"
"然后再中1次大奖。\p"
"那样总共能得到660枚代币，\n"
"不过非常难做到。$"

#: data/maps/MauvilleCity_GameCorner/scripts.inc:775
msgctxt "MauvilleCity_GameCorner_Text_CantPlayWithNoCoinCase"
msgid ""
"You can't play if you don't have\n"
"a COIN CASE.$"
msgstr ""
"没有代币盒的话\n"
"是不能玩的。$"
