#: data/maps/Route121/scripts.inc:171
msgctxt "Route121_Text_OkayMoveOutToMtPyre"
msgid ""
"Okay!\n"
"We're to move out to MT. PYRE!$"
msgstr ""
"好！\n"
"我们要向送神山出发了！$"

#: data/maps/Route121/scripts.inc:175
msgctxt "Route121_Text_AheadLoomsMtPyre"
msgid ""
"Ahead looms MT. PYRE…\p"
"It is a natural monument to the spirits \n"
"of departed POKéMON…$"
msgstr ""
"前方耸立着送神山……\p"
"那是供奉逝去的宝可梦的灵魂的\n"
"天然纪念碑……$"

#: data/maps/Route121/scripts.inc:180
msgctxt "Route121_Text_MtPyrePierSign"
msgid ""
"MT. PYRE PIER\p"
"…The sign is old and worn out.\n"
"The words are barely legible…$"
msgstr ""
"送神山码头\p"
"……告示牌又旧又破。\n"
"上面的字几乎看不清了……$"

#: data/maps/Route121/scripts.inc:185
msgctxt "Route121_Text_SafariZoneSign"
msgid ""
"“Filled with rare POKéMON!”\n"
"SAFARI ZONE$"
msgstr ""
"“这里有很多稀有的宝可梦！”\n"
"狩猎地带$"
