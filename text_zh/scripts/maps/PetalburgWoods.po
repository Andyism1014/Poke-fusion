#: data/maps/PetalburgWoods/scripts.inc:318
msgctxt "PetalburgWoods_Text_NotAOneToBeFound"
msgid ""
"Hmmm…\n"
"Not a one to be found…$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:322
msgctxt "PetalburgWoods_Text_HaveYouSeenShroomish"
msgid ""
"Hello, have you seen any POKéMON\n"
"called SHROOMISH around here?\p"
"I really love that POKéMON.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:327
msgctxt "PetalburgWoods_Text_IWasGoingToAmbushYou"
msgid ""
"I was going to ambush you, but you\n"
"had to dawdle in PETALBURG WOODS\l"
"forever, didn't you?\p"
"I got sick of waiting, so here I am!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:333
msgctxt "PetalburgWoods_Text_HandOverThosePapers"
msgid ""
"You! DEVON RESEARCHER!\p"
"Hand over those papers!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:337
msgctxt "PetalburgWoods_Text_YouHaveToHelpMe"
msgid ""
"Aiyeeeh!\p"
"You're a POKéMON TRAINER, aren't you?\n"
"You've got to help me, please!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:342
msgctxt "PetalburgWoods_Text_NoOneCrossesTeamAqua"
msgid ""
"Hunh? What do you think you're doing?\n"
"What, you're going to protect him?\p"
"No one who crosses TEAM AQUA\n"
"gets any mercy, not even a kid!\p"
"Come on and battle me!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:349
msgctxt "PetalburgWoods_Text_YoureKiddingMe"
msgid "You're kidding me! You're tough!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:352
msgctxt "PetalburgWoods_Text_YouveGotSomeNerve"
msgid ""
"Grrr… You've got some nerve\n"
"meddling with TEAM AQUA!\l"
"Come on and battle me again!\p"
"I wish I could say that, but I'm out of\n"
"POKéMON…\p"
"And, hey, we of TEAM AQUA are also\n"
"after something in RUSTBORO.\p"
"I'll let you go today!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:362
msgctxt "PetalburgWoods_Text_ThatWasAwfullyClose"
msgid ""
"Whew…\n"
"That was awfully close!\p"
"Thanks to you, he didn't rob me of\n"
"these important papers.\p"
"I know, I'll give you a GREAT BALL as\n"
"my thanks!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:370
msgctxt "PetalburgWoods_Text_TeamAquaAfterSomethingInRustboro"
msgid ""
"Didn't that TEAM AQUA thug say\n"
"they were after something in\l"
"RUSTBORO, too?$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:375
msgctxt "PetalburgWoods_Text_ICantBeWastingTime"
msgid ""
"Uh-oh! It's a crisis!\n"
"I can't be wasting time!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:379
msgctxt "PetalburgWoods_Text_YoureLoadedWithItems"
msgid ""
"You're loaded with items.\n"
"I can't give you this GREAT BALL.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:383
msgctxt "PetalburgWoods_Text_GoBugPokemonTeam"
msgid ""
"I caught a whole bunch of POKéMON!\p"
"Go, go, go!\n"
"My BUG POKéMON team!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:388
msgctxt "PetalburgWoods_Text_ICouldntWin"
msgid ""
"I have all these POKéMON,\n"
"but I couldn't win…$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:392
msgctxt "PetalburgWoods_Text_ImOutOfPokeBalls"
msgid ""
"I caught a bunch of POKéMON.\n"
"Now I'm out of POKé BALLS.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:396
msgctxt "PetalburgWoods_Text_InstantlyPopularWithBugPokemon"
msgid ""
"If you take BUG POKéMON to school,\n"
"you get to be instantly popular!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:400
msgctxt "PetalburgWoods_Text_CantBePopularIfILose"
msgid "I can't be popular if I lose.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:403
msgctxt "PetalburgWoods_Text_PeopleRespectYou"
msgid ""
"If you have a big BUG POKéMON,\n"
"people respect you for it.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:407
msgctxt "PetalburgWoods_Text_IWantRematch1"
msgid ""
"I want a rematch when my BUG\n"
"POKéMON grow up!\p"
"I'm registering you in my POKéNAV!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:412
msgctxt "PetalburgWoods_Text_IWantRematch2"
msgid ""
"I want a rematch when my BUG \n"
"POKéMON grow up!\p"
"I'm registering you in my POKéNAV!$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:417
msgctxt "PetalburgWoods_Text_MyPokemonHaveGrown"
msgid ""
"My BUG POKéMON have grown.\n"
"I'll be popular again.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:421
msgctxt "PetalburgWoods_Text_CantBePopularIfLose"
msgid "I can't be popular if I lose.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:424
msgctxt "PetalburgWoods_Text_IveBeenTrainingHard"
msgid ""
"You get to be popular if you have\n"
"strong POKéMON, right?\l"
"So, I've been training hard.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:429
msgctxt "PetalburgWoods_Text_StayOutOfTallGrass"
msgid ""
"Yo, there!\n"
"Your POKéMON doing okay?\p"
"If your POKéMON are weak and you want\n"
"to avoid battles, you should stay out\l"
"of tall grass.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:436
msgctxt "PetalburgWoods_Text_HiddenItemsExplanation"
msgid ""
"Sometimes, there are things on the\n"
"ground even if you can't see them.\p"
"That's why I always check where I'm\n"
"walking.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:442
msgctxt "PetalburgWoods_Text_TryUsingThisItem"
msgid ""
"Oh, neat!\n"
"That's the BADGE from RUSTBORO GYM!\p"
"You must be a TRAINER.\n"
"You should try using this item.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:448
msgctxt "PetalburgWoods_Text_MiracleSeedExplanation"
msgid ""
"It's a MIRACLE SEED.\n"
"If a POKéMON holds that item, its\l"
"GRASS-type moves become stronger.\p"
"Besides MIRACLE SEED, I think there are\n"
"other convenient items for POKéMON\l"
"to hold.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:456
msgctxt "PetalburgWoods_Text_TrainerTipsExperience"
msgid ""
"TRAINER TIPS\p"
"Any POKéMON that appears even once\n"
"in a battle is awarded EXP Points.\p"
"To raise a weak POKéMON, put it at the\n"
"left of the team list.\p"
"As soon as a battle starts, switch it\n"
"out. It will earn EXP Points without\l"
"being exposed to any harm.$"
msgstr ""

#: data/maps/PetalburgWoods/scripts.inc:466
msgctxt "PetalburgWoods_Text_TrainerTipsPP"
msgid ""
"TRAINER TIPS\p"
"In addition to Hit Points (HP), POKéMON\n"
"have Power Points (PP) that are used to\l"
"make moves during battle.\p"
"If a POKéMON runs out of PP, it must be\n"
"taken to a POKéMON CENTER.$"
msgstr ""
