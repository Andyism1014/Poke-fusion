#: data/maps/PetalburgCity/scripts.inc:745
msgctxt "PetalburgCity_Text_AreYouATrainer"
msgid ""
"Excuse me!\p"
"Let me guess, from the way you're\n"
"dressed, are you a POKéMON TRAINER?$"
msgstr ""

#: data/maps/PetalburgCity/scripts.inc:750
msgctxt "PetalburgCity_Text_WellMaybeNot"
msgid ""
