"红色花纹的画框。$"

#: data/maps/LilycoveCity_LilycoveMuseum_2F/scripts.inc:308
msgctxt "LilycoveCity_LilycoveMuseum_2F_Text_ItsGreenPictureFrame"
msgid ""
"It's a picture frame with\n"
"green-colored adornments.$"
msgstr ""
