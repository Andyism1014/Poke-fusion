#: data/maps/Route113_GlassWorkshop/scripts.inc:294
msgctxt "Route113_GlassWorkshop_Text_GoCollectAshWithThis"
msgid ""
"This area is covered in volcanic ash,\n"
"huff-puff!\p"
"I'm specially gifted, huff-puff.\p"
"I make glass out of volcanic ash\n"
"and make items, huff-puff.\p"
"Go collect ashes with this, huff-puff.$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:302
msgctxt "Route113_GlassWorkshop_Text_ExplainSootSack"
msgid ""
"Just take that SOOT SACK and walk\n"
"through piles of ash, huff-puff.\p"
"And it will fill up with the volcanic ash,\n"
"huff-puff.\p"
"Once you think you've collected a good\n"
"amount, come see me, huff-puff.$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:310
msgctxt "Route113_GlassWorkshop_Text_LetsSeeCollectedAshes"
msgid ""
"Have you collected ashes, huff-puff?\n"
"Let me see, huff-puff.$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:314
msgctxt "Route113_GlassWorkshop_Text_NotEnoughAshNeedX"
msgid ""
"Hmmm…\n"
"There's not enough ash here, huff-puff.\l"
"I can't make glass with this, huff-puff.\p"
"Let's see… {STR_VAR_1} is the number of steps\n"
"you'll need to walk for me to make you\l"
"a BLUE FLUTE, huff-puff.$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:322
msgctxt "Route113_GlassWorkshop_Text_WhichGlassItemWoudYouLike"
msgid ""
"Oh!\n"
"You've got a lot of ashes, huff-puff!\p"
"I'll make you a glass item, huff-puff!\n"
"Which one would you like, huff-puff?$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:328
msgctxt "Route113_GlassWorkshop_Text_IsThatTheItemForYou"
msgid ""
"A {STR_VAR_1}, huff-puff?\n"
"Is that the one for you, huff-puff?$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:332
msgctxt "Route113_GlassWorkshop_Text_WhichWouldYouLike"
msgid "Which one would you like, huff-puff?$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:335
msgctxt "Route113_GlassWorkshop_Text_IllMakeItemForYou"
msgid ""
"A {STR_VAR_1} it is, then, huff-puff!\p"
"Okay! I'll make it for you, huff-puff.\n"
"Just wait a little while, huff-puff.$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:340
msgctxt "Route113_GlassWorkshop_Text_NotEnoughAshToMakeItem"
msgid ""
"A {STR_VAR_1}, huff-puff?\p"
"There's not enough ash here to make\n"
"that, though, huff-puff.\p"
"Let's see… {STR_VAR_2} is the number of steps\n"
"you'll need to walk through volcanic ash\l"
"for me to make that item, huff-puff.\p"
"Which item would you rather have me\n"
"make instead, huff-puff?$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:350
msgctxt "Route113_GlassWorkshop_Text_AllThatAshButDontWantAnything"
msgid ""
"You've collected all that ash, but you\n"
"don't want anything, huff-puff?$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:354
msgctxt "Route113_GlassWorkshop_Text_IveFinishedGlassItem"
msgid ""
"Ah, I've finished your {STR_VAR_1}.\n"
"Take it, huff-puff.$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:358
msgctxt "Route113_GlassWorkshop_Text_NoRoomInBag"
msgid ""
"Oh?\n"
"You've no room in your BAG, huff-puff.\p"
"I'll hold on to it, so come back later,\n"
"huff-puff.$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:364
msgctxt "Route113_GlassWorkshop_Text_NoRoomInPC"
msgid ""
"Oh?\n"
"You've no room in your PC, huff-puff?\p"
"I'll hold on to it, so come back later,\n"
"huff-puff.$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:370
msgctxt "Route113_GlassWorkshop_Text_HaventGotYourSootSack"
msgid ""
"Hah? You haven't got your SOOT SACK\n"
"with you, huff-puff.\p"
"You have to keep it with you to collect\n"
"volcanic ash, huff-puff.$"
msgstr ""

#: data/maps/Route113_GlassWorkshop/scripts.inc:376
msgctxt "Route113_GlassWorkshop_Text_FunToBlowGlassFlute"
msgid ""
"It's fun to blow a glass flute while\n"
"my boss is talking.\p"
"Huff-huff! Puff-puff!$"
msgstr ""
