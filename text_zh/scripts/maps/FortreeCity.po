#: data/maps/FortreeCity/scripts.inc:90
msgctxt "FortreeCity_Text_SawGiganticPokemonInSky"
msgid ""
"No one believes me, but I saw this\n"
"gigantic POKéMON in the sky.\p"
"It seemed to squirm as it flew toward\n"
"ROUTE 131.\p"
"By the way… Sniff…\n"
"Um… You, uh…smell singed.\p"
"Were you at a volcano or something?$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:99
msgctxt "FortreeCity_Text_SomethingBlockingGym"
msgid ""
"I want to go to the POKéMON GYM,\n"
"but something's blocking the way.\p"
"After all the bother I went through\n"
"training on ROUTE 120…$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:105
msgctxt "FortreeCity_Text_ThisTimeIllBeatWinona"
msgid ""
"I've got my pride-and-joy POKéMON\n"
"with me. This time, I'll beat WINONA.$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:109
msgctxt "FortreeCity_Text_TreesGrowByDrinkingRainwater"
msgid ""
"The ground absorbs rainwater, and\n"
"trees grow by drinking that water…\p"
"Our FORTREE CITY exists because\n"
"there's both water and soil.$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:115
msgctxt "FortreeCity_Text_EveryoneHealthyAndLively"
msgid ""
"The CITY consists of homes built on\n"
"trees.\p"
"Perhaps because of that lifestyle,\n"
"everyone is healthy and lively.\p"
"Why, even myself--I feel as if I've\n"
"grown thirty years younger.$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:123
msgctxt "FortreeCity_Text_BugPokemonComeThroughWindow"
msgid ""
"Living on top of trees is okay.\p"
"But sometimes BUG POKéMON come in\n"
"through windows.\l"
"It can be really startling.$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:129
msgctxt "FortreeCity_Text_PokemonThatEvolveWhenTraded"
msgid ""
"There are POKéMON that evolve when\n"
"you trade them! That's what I heard.$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:133
msgctxt "FortreeCity_Text_SomethingUnseeable"
msgid "Something unseeable is in the way.$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:136
msgctxt "FortreeCity_Text_UnseeableUseDevonScope"
msgid ""
"Something unseeable is in the way.\p"
"Want to use the DEVON SCOPE?$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:140
msgctxt "FortreeCity_Text_UsedDevonScopePokemonFled"
msgid ""
"{PLAYER} used the DEVON SCOPE.\p"
"An invisible POKéMON became completely\n"
"visible!\p"
"The startled POKéMON fled!$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:146
msgctxt "FortreeCity_Text_CitySign"
msgid ""
"FORTREE CITY\n"
"“The treetop city that frolics with\l"
"nature.”$"
msgstr ""

#: data/maps/FortreeCity/scripts.inc:151
msgctxt "FortreeCity_Text_GymSign"
msgid ""
"FORTREE CITY POKéMON GYM\n"
"LEADER: WINONA\p"
"“The bird user taking flight into\n"
"the world.”$"
msgstr ""
