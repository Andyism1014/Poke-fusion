#: data/maps/MtPyre_2F/scripts.inc:49
msgctxt "MtPyre_2F_Text_TumbledFromFloorAbove"
msgid ""
"Ooch, ouch… There are holes in the\n"
"ground here and there.\p"
"I didn't notice and took a tumble from\n"
"the floor above.$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:55
msgctxt "MtPyre_2F_Text_MarkIntro"
msgid ""
"Hey! Are you searching for POKéMON?\n"
"You came along after me! You're rude!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:59
msgctxt "MtPyre_2F_Text_MarkDefeat"
msgid ""
"Ayieeeeh!\n"
"I'm sorry, forgive me, please!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:63
msgctxt "MtPyre_2F_Text_MarkPostBattle"
msgid ""
"People don't come here often, so\n"
"I thought there'd be rare POKéMON.$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:67
msgctxt "MtPyre_2F_Text_LukeIntro"
msgid ""
"LUKE: We're here on a dare.\p"
"Heheh, if I show her how cool I am,\n"
"she'll fall for me. I know it!\p"
"I know! I'll cream you and show her\n"
"how cool I am!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:74
msgctxt "MtPyre_2F_Text_LukeDefeat"
msgid "LUKE: Whoopsie!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:77
msgctxt "MtPyre_2F_Text_LukePostBattle"
msgid ""
"LUKE: Well, we lost but that's okay!\n"
"I'm right here by your side.\l"
"We'll make it through this dare!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:82
msgctxt "MtPyre_2F_Text_LukeNotEnoughMons"
msgid ""
"LUKE: If you want to take me on,\n"
"bring some more POKéMON.\p"
"If you don't, I won't be able to show\n"
"off to my girl how cool I am!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:88
msgctxt "MtPyre_2F_Text_DezIntro"
msgid ""
"DEZ: I came here on a dare with my\n"
"boyfriend.\p"
"It's really scary, but I'm with my\n"
"boyfriend. It's okay.\p"
"I know! I'll get my boyfriend to look\n"
"cool by beating you!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:96
msgctxt "MtPyre_2F_Text_DezDefeat"
msgid "DEZ: Waaaah! I'm scared!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:99
msgctxt "MtPyre_2F_Text_DezPostBattle"
msgid ""
"DEZ: We're lovey-dovey, so we don't\n"
"care if we lose!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:103
msgctxt "MtPyre_2F_Text_DezNotEnoughMons"
msgid ""
"DEZ: If you want to challenge us, you\n"
"should bring at least two POKéMON.\p"
"My boyfriend's strong.\n"
"Just one POKéMON won't do at all.$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:109
msgctxt "MtPyre_2F_Text_LeahIntro"
msgid ""
"You are an unfamiliar sight…\n"
"Depart before anything befalls you!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:113
msgctxt "MtPyre_2F_Text_LeahDefeat"
msgid ""
"Hmm…\n"
"You're durable.$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:117
msgctxt "MtPyre_2F_Text_LeahPostBattle"
msgid ""
"Our family has been TRAINERS here\n"
"since my great-grandmother's time…\p"
"It is my duty to protect this\n"
"mountain…$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:123
msgctxt "MtPyre_2F_Text_ZanderIntro"
msgid ""
"Kiyaaaaah!\n"
"I'm terrified!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:127
msgctxt "MtPyre_2F_Text_ZanderDefeat"
msgid ""
"Nooooooo!\n"
"I lost my wits!$"
msgstr ""

#: data/maps/MtPyre_2F/scripts.inc:131
msgctxt "MtPyre_2F_Text_ZanderPostBattle"
msgid ""
"I get freaked out every time I see\n"
"anything move…\p"
"I shouldn't have come here to train…$"
msgstr ""
