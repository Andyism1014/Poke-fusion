#: data/maps/BattleFrontier_BattlePikeLobby/scripts.inc:422
msgctxt "BattleFrontier_BattlePikeLobby_Text_ExplainPokenavBagRules"
msgid ""
"The BAG and POKéNAV may not be used\n"
"during a Battle Choice challenge.$"
msgstr ""

#: data/maps/BattleFrontier_BattlePikeLobby/scripts.inc:426
msgctxt "BattleFrontier_BattlePikeLobby_Text_ExplainHeldItemRules"
msgid ""
"During a Battle Choice challenge,\n"
"any BERRY or HERB held by POKéMON\l"
"will be effective only once.$"
msgstr ""

#: data/maps/BattleFrontier_BattlePikeLobby/scripts.inc:431
msgctxt "BattleFrontier_BattlePikeLobby_Text_ExplainMonOrderRules"
msgid ""
"During a Battle Choice challenge,\n"
"the sequence of POKéMON cannot be\l"
"changed.\p"
"The sequence must be set before\n"
"starting your challenge.$"
msgstr ""
