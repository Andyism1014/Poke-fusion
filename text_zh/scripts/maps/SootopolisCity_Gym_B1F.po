#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:54
msgctxt "SootopolisCity_Gym_B1F_Text_AndreaIntro"
msgid ""
"I'll show you the sublime techniques\n"
"I learned from our LEADER JUAN!$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:58
msgctxt "SootopolisCity_Gym_B1F_Text_AndreaDefeat"
msgid "Please forgive me, JUAN…$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:61
msgctxt "SootopolisCity_Gym_B1F_Text_AndreaPostBattle"
msgid ""
"Watch what happens if you crack all\n"
"the floor tiles.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:65
msgctxt "SootopolisCity_Gym_B1F_Text_CrissyIntro"
msgid ""
"You came all the way here, but you won't\n"
"get to see JUAN.\p"
"Not if you lose to me, you won't!$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:70
msgctxt "SootopolisCity_Gym_B1F_Text_CrissyDefeat"
msgid ""
"You're strong!\n"
"I was fooled by your cute looks!$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:74
msgctxt "SootopolisCity_Gym_B1F_Text_CrissyPostBattle"
msgid ""
"You might be good enough to avoid\n"
"being wiped out in one hit by JUAN.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:78
msgctxt "SootopolisCity_Gym_B1F_Text_DaphneIntro"
msgid ""
"The sight of JUAN conducting\n"
"a battle…\p"
"The very beauty of it compelled me to\n"
"become a TRAINER.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:84
msgctxt "SootopolisCity_Gym_B1F_Text_DaphneDefeat"
msgid ""
"You battled with more beauty than\n"
"I could muster…$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:88
msgctxt "SootopolisCity_Gym_B1F_Text_DaphnePostBattle"
msgid ""
"The grace you bring to battle is\n"
"fabulous.\p"
"Oh… I'm so fortunate to have found\n"
"POKéMON.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:94
msgctxt "SootopolisCity_Gym_B1F_Text_ConnieIntro"
msgid ""
"I should teach you how harsh battles\n"
"can be.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:98
msgctxt "SootopolisCity_Gym_B1F_Text_ConnieDefeat"
msgid ""
"Oh.\n"
"You're strong.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:102
msgctxt "SootopolisCity_Gym_B1F_Text_ConniePostBattle"
msgid ""
"I'll tell you something good.\p"
"If you want to reach JUAN, you\n"
"need to walk on each floor tile once.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:107
msgctxt "SootopolisCity_Gym_B1F_Text_BridgetIntro"
msgid ""
"The POKéMON GYM of the highest level\n"
"in the HOENN region…\p"
"That's the SOOTOPOLIS GYM.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:112
msgctxt "SootopolisCity_Gym_B1F_Text_BridgetDefeat"
msgid "What a high level you are!$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:115
msgctxt "SootopolisCity_Gym_B1F_Text_BridgetPostBattle"
msgid ""
"Rather than being satisfied by being\n"
"in a strong GYM, I imagine training in\l"
"other places will make you stronger.\l"
"But above all, it looks more fun.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:121
msgctxt "SootopolisCity_Gym_B1F_Text_OliviaIntro"
msgid ""
"I train my POKéMON together with\n"
"JUAN.\p"
"Don't think I'm a pushover.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:126
msgctxt "SootopolisCity_Gym_B1F_Text_OliviaDefeat"
msgid "I was beaten…$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:129
msgctxt "SootopolisCity_Gym_B1F_Text_OliviaPostBattle"
msgid ""
"I think you have potential.\n"
"Why don't you stay and train with us?$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:133
msgctxt "SootopolisCity_Gym_B1F_Text_TiffanyIntro"
msgid ""
"A graceful glide across the ice while\n"
"crossing no lines…\p"
"A TRAINER putting on that performance\n"
"would be elegantly beautiful!$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:139
msgctxt "SootopolisCity_Gym_B1F_Text_TiffanyDefeat"
msgid "Well, excuse me?!$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:142
msgctxt "SootopolisCity_Gym_B1F_Text_TiffanyPostBattle"
msgid ""
"This is really obvious, but how strong\n"
"you are as a TRAINER has nothing to do\l"
"with how young or old you are.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:147
msgctxt "SootopolisCity_Gym_B1F_Text_BethanyIntro"
msgid ""
"When I'm with my POKéMON, the time\n"
"flies by before you can say, “Oops!”$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:151
msgctxt "SootopolisCity_Gym_B1F_Text_BethanyDefeat"
msgid "Oops!$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:154
msgctxt "SootopolisCity_Gym_B1F_Text_BethanyPostBattle"
msgid ""
"I wish I could forget about lost causes\n"
"before I can manage an “Oops!”$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:158
msgctxt "SootopolisCity_Gym_B1F_Text_AnnikaIntro"
msgid ""
"I can battle with really rare POKéMON\n"
"if you'd like.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:162
msgctxt "SootopolisCity_Gym_B1F_Text_AnnikaDefeat"
msgid ""
"Oh, there now! Did you have a good look\n"
"at my POKéMON?$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:166
msgctxt "SootopolisCity_Gym_B1F_Text_AnnikaPostBattle"
msgid ""
"I came to this GYM because JUAN\n"
"praised me for my darling POKéMON.\p"
"Oh, if only I'd met JUAN years ago\n"
"when I was younger…$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:172
msgctxt "SootopolisCity_Gym_B1F_Text_BriannaIntro"
msgid ""
"Giggle…\n"
"Your grim look is so charming.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:176
msgctxt "SootopolisCity_Gym_B1F_Text_BriannaDefeat"
msgid ""
"Oh, dear.\n"
"I went much too easy on you.$"
msgstr ""

#: data/maps/SootopolisCity_Gym_B1F/scripts.inc:180
msgctxt "SootopolisCity_Gym_B1F_Text_BriannaPostBattle"
msgid ""
"You couldn't lay a finger on JUAN,\n"
"I'm sure. Giggle…$"
msgstr ""
