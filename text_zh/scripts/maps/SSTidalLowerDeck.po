#: data/maps/SSTidalLowerDeck/scripts.inc:14
msgctxt "SSTidalLowerDeck_Text_PhillipIntro"
msgid ""
"Arrrgh! I'm fed up and dog-tired of\n"
"cleaning this huge place!\p"
"Let's have a quick battle!$"
msgstr ""
"啊啊啊！打扫这么大的地方，\n"
"我已经累得受不了了！\p"
"我们来速战速决吧！$"

#: data/maps/SSTidalLowerDeck/scripts.inc:19
msgctxt "SSTidalLowerDeck_Text_PhillipDefeat"
msgid "Little bro, I lost!$"
msgstr "弟弟，我输了！$"

#: data/maps/SSTidalLowerDeck/scripts.inc:22
msgctxt "SSTidalLowerDeck_Text_PhillipPostBattle"
msgid ""
"We're the CLEANUP BROTHERS!\p"
"The old one dumps the detergent,\n"
"and the young one does the scrubbing!$"
msgstr ""
"我们是清洁兄弟！\p"
"哥哥负责倒清洁剂，弟弟负责刷地板！$"

#: data/maps/SSTidalLowerDeck/scripts.inc:27
msgctxt "SSTidalLowerDeck_Text_LeonardIntro"
msgid ""
"This is the bottom of the ship's hull.\n"
"There's plenty of room.\l"
"It'll be alright for a POKéMON battle.$"
msgstr ""
"这里是船舱的最底层。地方很宽敞，\n"
"进行宝可梦对战没问题。$"

#: data/maps/SSTidalLowerDeck/scripts.inc:32
msgctxt "SSTidalLowerDeck_Text_LeonardDefeat"
msgid "Big bro, I lost!$"
msgstr "哥哥，我输了！$"

