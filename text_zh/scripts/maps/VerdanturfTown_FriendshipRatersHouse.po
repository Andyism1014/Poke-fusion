#: data/maps/VerdanturfTown_FriendshipRatersHouse/scripts.inc:65
msgctxt "VerdanturfTown_FriendshipRatersHouse_Text_SeeHowMuchPokemonLikesYou"
msgid ""
"Let me see your POKéMON.\n"
"I'll check to see how much it likes you.\p"
"Oh.\n"
"Your POKéMON…$"
msgstr ""

#: data/maps/VerdanturfTown_FriendshipRatersHouse/scripts.inc:71
msgctxt "VerdanturfTown_FriendshipRatersHouse_Text_AdoresYou"
msgid ""
"It adores you.\n"
"It can't possibly love you any more.\l"
"I even feel happy seeing it.$"
msgstr ""

#: data/maps/VerdanturfTown_FriendshipRatersHouse/scripts.inc:76
msgctxt "VerdanturfTown_FriendshipRatersHouse_Text_VeryHappy"
msgid ""
"It seems to be very happy.\n"
"It obviously likes you a whole lot.$"
msgstr ""

#: data/maps/VerdanturfTown_FriendshipRatersHouse/scripts.inc:80
msgctxt "VerdanturfTown_FriendshipRatersHouse_Text_LikesYouQuiteALot"
msgid ""
"It likes you quite a lot.\n"
"It seems to want to be babied a little.$"
msgstr ""

#: data/maps/VerdanturfTown_FriendshipRatersHouse/scripts.inc:84
msgctxt "VerdanturfTown_FriendshipRatersHouse_Text_GettingUsedToYou"
msgid ""
"It's getting used to you.\n"
"It seems to believe in you.$"
msgstr ""

#: data/maps/VerdanturfTown_FriendshipRatersHouse/scripts.inc:88
msgctxt "VerdanturfTown_FriendshipRatersHouse_Text_NotUsedToYou"
msgid ""
"It's not very used to you yet.\n"
"It neither loves nor hates you.$"
msgstr ""

#: data/maps/VerdanturfTown_FriendshipRatersHouse/scripts.inc:92
msgctxt "VerdanturfTown_FriendshipRatersHouse_Text_VeryWary"
msgid ""
"It's very wary.\n"
"It has scary viciousness in its eyes.\l"
"It doesn't like you much at all.$"
msgstr ""

#: data/maps/VerdanturfTown_FriendshipRatersHouse/scripts.inc:97
msgctxt "VerdanturfTown_FriendshipRatersHouse_Text_DetestsYou"
msgid ""
"This is a little hard for me to say…\p"
"Your POKéMON simply detests you.\n"
"Doesn't that make you uncomfortable?$"
msgstr ""

