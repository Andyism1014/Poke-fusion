#: data/maps/MirageTower_4F/scripts.inc:61
msgctxt "MirageTower_4F_Text_TakeRootFossil"
msgid ""
"You found the ROOT FOSSIL.\p"
"If this FOSSIL is taken, the ground\n"
"around it will likely crumble away…\p"
"Take the ROOT FOSSIL anyway?$"
msgstr ""
"你找到了根状化石。\p"
"如果拿走这块化石，\n"
"周围的地面很可能会崩塌……\p"
"还是要拿走根状化石吗？$"

#: data/maps/MirageTower_4F/scripts.inc:67
msgctxt "MirageTower_4F_Text_LeftRootFossilAlone"
msgid "{PLAYER} left the ROOT FOSSIL alone.$"
msgstr "{PLAYER}没有动根状化石。$"

