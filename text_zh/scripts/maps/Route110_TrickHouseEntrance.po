#: data/maps/Route110_TrickHouseEntrance/scripts.inc:697
msgctxt "Route110_TrickHouseEntrance_Text_YoureBeingWatched"
msgid "You're being watched…$"
msgstr "有人在看着你……$"

#: data/maps/Route110_TrickHouseEntrance/scripts.inc:700
msgctxt "Route110_TrickHouseEntrance_Text_ConcealedBeneathDesk"
msgid ""
"Hah? Grrr…\p"
"How did you know I concealed myself\n"
"beneath this desk? You're sharp!$"
msgstr ""
"哈？呜呜……\p"
"你怎么知道我躲在这张桌子下面？\n"
"你很敏锐嘛！$"

