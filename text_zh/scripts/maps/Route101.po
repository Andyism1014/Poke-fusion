#: data/maps/Route101/scripts.inc:259
msgctxt "Route101_Text_HelpMe"
msgid "H-help me!$"
msgstr "救、救命啊！$"

#: data/maps/Route101/scripts.inc:262
msgctxt "Route101_Text_PleaseHelp"
msgid ""
"Hello! You over there!\n"
"Please! Help!\p"
"In my BAG!\n"
"There's a POKé BALL!$"
msgstr ""
"喂！那边的你！\n"
"拜托了！救救我！\p"
"我的包包里！\n"
"有精灵球！$"

#: data/maps/Route101/scripts.inc:268
msgctxt "Route101_Text_DontLeaveMe"
msgid ""
"Wh-Where are you going?!\n"
"Don't leave me like this!$"
msgstr ""
"你、你要去哪里？！\n"
"别丢下我不管啊！$"

#: data/maps/Route101/scripts.inc:272
msgctxt "Route101_Text_YouSavedMe"
msgid ""
"PROF. BIRCH: Whew…\p"
"I was in the tall grass studying wild\n"
"POKéMON when I was jumped.\p"
"You saved me.\n"
"Thanks a lot!\p"
"Oh?\p"
"Hi, you're {PLAYER}{KUN}!\p"
"This is not the place to chat, so come\n"
"by my POKéMON LAB later, okay?$"
msgstr ""
"小田卷博士：呼……\p"
"我在草丛里研究野生宝可梦的时候，\n"
"突然被袭击了。\p"
"你救了我。\n"
"真是太感谢了！\p"
"哦？\p"
"你好，你就是{PLAYER}{KUN}吧！\p"
"这里不是聊天的地方，\n"
"等一下到我的宝可梦研究所来吧。$"

#: data/maps/Route101/scripts.inc:283
msgctxt "Route101_Text_TakeTiredPokemonToPokeCenter"
msgid ""
"If POKéMON get tired, take them to\n"
"a POKéMON CENTER.\p"
"There's a POKéMON CENTER in OLDALE\n"
"TOWN right close by.$"
msgstr ""
"要是宝可梦累了，\n"
"就带它们去宝可梦中心吧。\p"
"附近的古辰镇\n"
"就有宝可梦中心。$"

#: data/maps/Route101/scripts.inc:289
msgctxt "Route101_Text_WildPokemonInTallGrass"
msgid ""
"Wild POKéMON will jump out at you in\n"
"tall grass.\p"
"If you want to catch POKéMON, you have\n"
"to go into the tall grass and search.$"
msgstr ""
"在草丛里，野生宝可梦\n"
"会突然跳出来。\p"
"想要捉宝可梦的话，\n"
"就得走进草丛里去找。$"

#: data/maps/Route101/scripts.inc:295
msgctxt "Route101_Text_RouteSign"
msgid ""
"ROUTE 101\n"
"{UP_ARROW} OLDALE TOWN$"
msgstr ""
"101号道路\n"
"{UP_ARROW} 古辰镇$"
