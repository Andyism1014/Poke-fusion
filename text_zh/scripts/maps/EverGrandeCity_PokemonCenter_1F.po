#: data/maps/EverGrandeCity_PokemonCenter_1F/scripts.inc:76
msgctxt "EverGrandeCity_PokemonCenter_1F_Text_LeagueAfterVictoryRoad"
msgid ""
"The POKéMON LEAGUE is only a short\n"
"distance after the VICTORY ROAD.\p"
"If you've come this far, what choice\n"
"do you have but to keep going?$"
msgstr ""

#: data/maps/EverGrandeCity_PokemonCenter_1F/scripts.inc:82
msgctxt "EverGrandeCity_PokemonCenter_1F_Text_BelieveInYourPokemon"
msgid ""
"The long and harrowing VICTORY ROAD…\p"
"It's like reliving the path one has\n"
"traveled in life…\p"
"Believe in your POKéMON and give it\n"
"your very best!$"
msgstr ""

#: data/maps/EverGrandeCity_PokemonCenter_1F/scripts.inc:89
msgctxt "EverGrandeCity_PokemonCenter_1F_Text_ScottHappyForYou"
msgid ""
"SCOTT: {PLAYER}{KUN}, you've clawed your\n"
"way up to face the POKéMON LEAGUE!\p"
"I'm happy for you!\n"
"You made my cheering worthwhile!\p"
"{PLAYER}{KUN}, if you were to become\n"
"the POKéMON LEAGUE CHAMPION…\p"
"I'll get in touch with you then.\p"
"Okay, {PLAYER}{KUN}.\n"
"Go for greatness!$"
msgstr ""
