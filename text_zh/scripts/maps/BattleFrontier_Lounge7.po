#: data/maps/BattleFrontier_Lounge7/scripts.inc:304
msgctxt "BattleFrontier_Lounge7_Text_LeftTutorIntro"
msgid ""
"Buhahaha!\p"
"You couldn't tell it from looking now,\n"
"but I used to be one tough TRAINER.\p"
"I had a reputation as the toughest\n"
"BEAUTY around, I tell you!\p"
"… … … … … …\p"
"What is it now?\n"
"You don't believe me.\p"
"I'm not like that blowhard woman over\n"
"there. I'm actually talented!\p"
"Let me prove it to you.\n"
"I can teach your POKéMON special and\l"
"yet cute moves.\p"
"But my lessons don't come free.\n"
"How about paying for the moves I teach\l"
"with a wee bit of Battle Points?$"
msgstr ""

#: data/maps/BattleFrontier_Lounge7/scripts.inc:322
msgctxt "BattleFrontier_Lounge7_Text_LeftTutorWelcomeBack"
msgid ""
"Buhahaha!\p"
"Are you back to learn special and\n"
"yet cute POKéMON moves?$"
msgstr ""

#: data/maps/BattleFrontier_Lounge7/scripts.inc:327
msgctxt "BattleFrontier_Lounge7_Text_TeachWhichMove"
msgid ""
"Fine, fine, look here!\n"
"Which move should I teach?$"
msgstr ""

#: data/maps/BattleFrontier_Lounge7/scripts.inc:331
msgctxt "BattleFrontier_Lounge7_Text_MoveWillBeXBattlePoints"
msgid ""
"The move {STR_VAR_1}, is it?\n"
"That will be {STR_VAR_2} Battle Points, okay?$"
msgstr ""

#: data/maps/BattleFrontier_Lounge7/scripts.inc:335
msgctxt "BattleFrontier_Lounge7_Text_TeachMoveToWhichMon"
msgid ""
