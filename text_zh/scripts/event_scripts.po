msgstr ""
"{PLAYER}找到了{STR_VAR_3}个\n"
"{STR_VAR_1}“{STR_VAR_2}”！$"

#: data/event_scripts.s:1518
msgctxt "gText_Sudowoodo_Attacked"
msgid ""
"The weird tree doesn't like the\n"
"WAILMER PAIL!\p"
"The weird tree attacked!$"
msgstr ""
"这棵奇怪的树\n"
"不喜欢吼吼鲸喷壶！\p"
"奇怪的树发起了攻击！$"

#: data/event_scripts.s:1523
msgctxt "gText_LegendaryFlewAway"
