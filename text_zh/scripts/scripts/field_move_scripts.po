#: data/scripts/field_move_scripts.inc:46
msgctxt "Text_WantToCut"
msgid ""
"This tree looks like it can be\n"
"CUT down!\p"
"Would you like to CUT it?$"
msgstr ""
"这棵树好像可以\n"
"用居合斩砍掉！\p"
"要使用居合斩吗？$"

#: data/scripts/field_move_scripts.inc:51
msgctxt "Text_MonUsedFieldMove"
msgid "{STR_VAR_1} used {STR_VAR_2}!$"
msgstr "{STR_VAR_1}使用了{STR_VAR_2}！$"

#: data/scripts/field_move_scripts.inc:54
msgctxt "Text_CantCut"
msgid ""
"This tree looks like it can be\n"
"CUT down!$"
msgstr ""
"这棵树好像可以\n"
"用居合斩砍掉！$"

#: data/scripts/field_move_scripts.inc:216
msgctxt "Text_WantToSmash"
msgid ""
"This rock appears to be breakable.\n"
"Would you like to use ROCK SMASH?$"
msgstr ""
"这块岩石好像可以被击碎。\n"
"要使用碎岩吗？$"

#: data/scripts/field_move_scripts.inc:220
msgctxt "Text_CantSmash"
msgid ""
"It's a rugged rock, but a POKéMON\n"
"may be able to smash it.$"
msgstr ""
"这是一块坚硬的岩石，不过\n"
"宝可梦或许能把它击碎。$"

#: data/scripts/field_move_scripts.inc:266
msgctxt "Text_WantToStrength"
msgid ""
"It's a big boulder, but a POKéMON\n"
"may be able to push it aside.\p"
"Would you like to use STRENGTH?$"
msgstr ""
"这是一块大岩石，不过\n"
"宝可梦或许能把它推开。\p"
"要使用怪力吗？$"

#: data/scripts/field_move_scripts.inc:271
msgctxt "Text_MonUsedStrength"
msgid ""
"{STR_VAR_1} used STRENGTH!\p"
"{STR_VAR_1}'s STRENGTH made it\n"
"possible to move boulders around!$"
msgstr ""
"{STR_VAR_1}使用了怪力！\p"
"{STR_VAR_1}的怪力\n"
"让大岩石可以被推动了！$"

#: data/scripts/field_move_scripts.inc:276
msgctxt "Text_CantStrength"
msgid ""
"It's a big boulder, but a POKéMON\n"
"may be able to push it aside.$"
msgstr ""
"这是一块大岩石，不过\n"
"宝可梦或许能把它推开。$"

#: data/scripts/field_move_scripts.inc:280
msgctxt "Text_StrengthActivated"
msgid ""
"STRENGTH made it possible to move\n"
"boulders around.$"
msgstr ""
"怪力让大岩石\n"
"可以被推动了。$"

#: data/scripts/field_move_scripts.inc:308
msgctxt "Text_CantWaterfall"
msgid ""
"A wall of water is crashing down with\n"
"a mighty roar.$"
msgstr ""
"巨大的水墙\n"
"轰鸣着倾泻而下。$"

#: data/scripts/field_move_scripts.inc:312
msgctxt "Text_WantToWaterfall"
msgid ""
"It's a large waterfall.\n"
"Would you like to use WATERFALL?$"
msgstr ""
"这是一道巨大的瀑布。\n"
"要使用攀瀑吗？$"

#: data/scripts/field_move_scripts.inc:316
msgctxt "Text_MonUsedWaterfall"
msgid "{STR_VAR_1} used WATERFALL.$"
msgstr "{STR_VAR_1}使用了攀瀑。$"

#: data/scripts/field_move_scripts.inc:402
msgctxt "Text_CantDive"
msgid ""
"The sea is deep here. A POKéMON\n"
"may be able to go underwater.$"
msgstr ""
"这里的海很深。\n"
"宝可梦或许能潜入水中。$"

#: data/scripts/field_move_scripts.inc:406
msgctxt "Text_WantToDive"
msgid ""
"The sea is deep here.\n"
"Would you like to use DIVE?$"
msgstr ""
"这里的海很深。\n"
"要使用潜水吗？$"

#: data/scripts/field_move_scripts.inc:410
msgctxt "Text_MonUsedDive"
msgid "{STR_VAR_1} used DIVE.$"
msgstr "{STR_VAR_1}使用了潜水。$"

#: data/scripts/field_move_scripts.inc:413
msgctxt "Text_CantSurface"
msgid ""
"Light is filtering down from above.\n"
"A POKéMON may be able to surface.$"
msgstr ""
"光线从上方透了下来。\n"
"宝可梦或许能浮上水面。$"

#: data/scripts/field_move_scripts.inc:417
msgctxt "Text_WantToSurface"
msgid ""
