#: data/scripts/field_move_scripts.inc:425
msgctxt "Text_FailSweetScent"
msgid "Looks like there's nothing here…$"
msgstr "这里好像什么都没有……$"

#: data/scripts/field_move_scripts.inc:467
msgctxt "Text_WantToRockClimb"
msgid ""
"The cliff is steep.\n"
"Would you like to use Rock Climb?$"
msgstr ""
"这是一面陡峭的山崖。\n"
"要使用攀岩吗？$"

#: data/scripts/field_move_scripts.inc:471
msgctxt "Text_MonUsedRockClimb"
msgid "{STR_VAR_1} used Rock Climb!$"
msgstr "{STR_VAR_1}使用了攀岩！$"

#: data/scripts/field_move_scripts.inc:474
msgctxt "Text_CantRockClimb"
msgid ""
"The cliff is steep.\n"
"A Pokémon may be able to climb it.$"
msgstr ""
