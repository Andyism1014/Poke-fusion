#: data/scripts/lilycove_lady.inc:523
msgctxt "LilycoveCity_PokemonCenter_1F_Text_ImTheFavorLady"
msgid "I'm the FAVOR LADY…$"
msgstr "我是讨要大姐姐……$"

#: data/scripts/lilycove_lady.inc:526
msgctxt "LilycoveCity_PokemonCenter_1F_Text_ObsessedWithThing"
msgid ""
"I've recently developed an obsession\n"
"for {STR_VAR_1} things…$"
msgstr ""
"我最近迷上了\n"
"{STR_VAR_1}的东西……$"

#: data/scripts/lilycove_lady.inc:530
msgctxt "LilycoveCity_PokemonCenter_1F_Text_ThankYouForLastTime"
msgid ""
"Oh…\n"
"Thank you for last time…$"
msgstr ""
"哦……\n"
"上次谢谢你了……$"

#: data/scripts/lilycove_lady.inc:534
msgctxt "LilycoveCity_PokemonCenter_1F_Text_PlayerGaveMeBadThing"
msgid ""
"Before, I think it was {STR_VAR_3}…\p"
"{STR_VAR_3} gave me one {STR_VAR_2},\n"
"saying it was {STR_VAR_1}.\p"
"But it wasn't {STR_VAR_1}.\n"
"Not in the least bit.$"
msgstr ""
"之前，我记得是{STR_VAR_3}……\p"
"{STR_VAR_3}送给我一个{STR_VAR_2}，\n"
"说它是{STR_VAR_1}的。\p"
"可是它一点也不\n"
"{STR_VAR_1}。$"

#: data/scripts/lilycove_lady.inc:541
msgctxt "LilycoveCity_PokemonCenter_1F_Text_PlayerGaveMeGreatThing"
msgid ""
"Before, {STR_VAR_3} gave me a very\n"
"{STR_VAR_1} {STR_VAR_2}.\p"
"I cherish it now.$"
msgstr ""
"之前，{STR_VAR_3}送给我一个\n"
"非常{STR_VAR_1}的{STR_VAR_2}。\p"
"我现在可珍惜它了。$"

#: data/scripts/lilycove_lady.inc:546
msgctxt "LilycoveCity_PokemonCenter_1F_Text_WillYouShareThing"
msgid ""
"Listen, if you have anything that\n"
"is {STR_VAR_1}, will you share it\l"
"with me?$"
msgstr ""
"听我说，如果你有什么\n"
"{STR_VAR_1}的东西，\l"
"能分给我吗？$"

#: data/scripts/lilycove_lady.inc:551
msgctxt "LilycoveCity_PokemonCenter_1F_Text_WhatWillYouGiveMe"
msgid ""
"…Really?\n"
"What will you give me?$"
msgstr ""
"……真的吗？\n"
"你要给我什么呢？$"

#: data/scripts/lilycove_lady.inc:555
msgctxt "LilycoveCity_PokemonCenter_1F_Text_IsThatSoGoodbye"
msgid ""
"Is that so?\n"
"Then, it's good-bye…$"
msgstr ""
"是吗？\n"
"那么，再见了……$"

#: data/scripts/lilycove_lady.inc:559
msgctxt "LilycoveCity_PokemonCenter_1F_Text_NotWillingToShare"
msgid ""
"Oh…\n"
"You're not willing to share?$"
msgstr ""
"哦……\n"
"你不愿意分给我吗？$"

#: data/scripts/lilycove_lady.inc:563
msgctxt "LilycoveCity_PokemonCenter_1F_Text_IllTryToCherishIt"
msgid ""
"Oh?\n"
"That {STR_VAR_2} is {STR_VAR_1}?\p"
"…Oh, is that right?\p"
"Well, I owe you a thanks anyway.\n"
"I'll try to cherish it…$"
msgstr ""
"哦？\n"
"那个{STR_VAR_2}是{STR_VAR_1}的？\p"
"……哦，是这样吗？\p"
"好吧，总之还是要谢谢你。\n"
"我会试着好好珍惜它的……$"

#: data/scripts/lilycove_lady.inc:570
msgctxt "LilycoveCity_PokemonCenter_1F_Text_IWillCherishThis"
msgid ""
"Oh…\p"
"That's a quite {STR_VAR_1}\n"
"{STR_VAR_2}…\p"
"Isn't it nice?\n"
"It's so dreamy…\p"
"Thank you…\n"
"I will cherish this…$"
msgstr ""
"哦……\p"
"这真是个相当{STR_VAR_1}的\n"
"{STR_VAR_2}……\p"
"很不错吧？\n"
"真像在做梦一样……\p"
"谢谢你……\n"
"我会好好珍惜它的……$"

#: data/scripts/lilycove_lady.inc:579
msgctxt "LilycoveCity_PokemonCenter_1F_Text_IWillTreasureThis"
msgid ""
"…Oh, oh, oh…\p"
"This is amazing!\n"
"This really is {STR_VAR_1}!\p"
"I never knew that one {STR_VAR_2}\n"
"could be this {STR_VAR_1}!\p"
"Thank you!\p"
"I will treasure this for the rest\n"
"of my life!$"
msgstr ""
"……哦，哦，哦……\p"
"太了不起了！\n"
"这真的是{STR_VAR_1}的！\p"
"我从来不知道一个{STR_VAR_2}\n"
"可以这么{STR_VAR_1}！\p"
"谢谢你！\p"
"我会把它当作一辈子的宝贝！$"

#: data/scripts/lilycove_lady.inc:589
msgctxt "LilycoveCity_PokemonCenter_1F_Text_IllGiveYouThisInReturn"
msgid ""
"I'll give you this wonderful item in\n"
"return for your fabulous gift.\p"
"I hope you will cherish it…$"
msgstr ""
"为了回报你这份很棒的礼物，\n"
"我送你这个好东西。\p"
"希望你会珍惜它……$"

#: data/scripts/lilycove_lady.inc:594
msgctxt "LilycoveCity_PokemonCenter_1F_Text_YouDontHaveSpaceForIt"
msgid ""
"Oh, you can't have it if you don't have\n"
"the space for it.\p"
"Please come see me when you get\n"
"your BAG organized…$"
msgstr ""
"哎呀，你没有地方放的话，\n"
"就没法收下它了。\p"
"请整理好背包\n"
"之后再来找我吧……$"

#: data/scripts/lilycove_lady.inc:600
msgctxt "LilycoveCity_PokemonCenter_1F_Text_ImTheQuizLady"
msgid ""
"I'm the QUIZ LADY!\n"
"I love quizzes!$"
msgstr ""
"我是猜谜大姐姐！\n"
"我最喜欢猜谜了！$"

#: data/scripts/lilycove_lady.inc:604
msgctxt "LilycoveCity_PokemonCenter_1F_Text_WaitingToTakeYourQuiz"
msgid ""
"Oh?\p"
"I'm waiting for a challenger to answer\n"
"the quiz you made.\p"
"We can chat another time, okay?$"
msgstr ""
"哦？\p"
"我正在等挑战者\n"
"来回答你出的题目。\p"
"我们下次再聊，好吗？$"

#: data/scripts/lilycove_lady.inc:610
msgctxt "LilycoveCity_PokemonCenter_1F_Text_WaitingForChallenger"
msgid ""
"I'm waiting for someone to challenge\n"
"a quiz this {STR_VAR_1} thought up!$"
msgstr ""
"我正在等人来挑战\n"
"这位{STR_VAR_1}出的题目！$"

#: data/scripts/lilycove_lady.inc:614
msgctxt "LilycoveCity_PokemonCenter_1F_Text_TakeQuizChallenge"
msgid ""
"If you answer correctly, you can win\n"
"fabulous prizes!\p"
"Would you like to take the quiz\n"
"challenge?$"
msgstr ""
"如果答对了，\n"
"就能赢得很棒的奖品！\p"
"要挑战猜谜吗？$"

#: data/scripts/lilycove_lady.inc:620
msgctxt "LilycoveCity_PokemonCenter_1F_Text_WaitForAnswer"
msgid ""
"… … … … … …\n"
"… … … … … …$"
msgstr ""
"…… …… ……\n"
"…… …… ……$"

#: data/scripts/lilycove_lady.inc:624
msgctxt "LilycoveCity_PokemonCenter_1F_Text_HowBoringBye"
msgid ""
"Oh, how boring!\n"
"Bye-bye!$"
msgstr ""
"哎呀，真没意思！\n"
"拜拜！$"

#: data/scripts/lilycove_lady.inc:628
msgctxt "LilycoveCity_PokemonCenter_1F_Text_YoureGoingToQuit"
msgid ""
"Awww!\n"
"You're going to quit?$"
msgstr ""
"啊——！\n"
"你要放弃了吗？$"

#: data/scripts/lilycove_lady.inc:632
msgctxt "LilycoveCity_PokemonCenter_1F_Text_TakeTheQuizAnotherTime"
msgid ""
"Please take the quiz challenge\n"
"another time!$"
msgstr ""
"下次再来\n"
"挑战猜谜吧！$"

#: data/scripts/lilycove_lady.inc:636
msgctxt "LilycoveCity_PokemonCenter_1F_Text_YouGotItRight"
msgid ""
"You're amazing! You've got it right!\n"
"You're one sharp customer!$"
msgstr ""
"太厉害了！你答对了！\n"
"你可真聪明！$"

#: data/scripts/lilycove_lady.inc:640
msgctxt "LilycoveCity_PokemonCenter_1F_Text_YouGotItRightYouveWonPersonsPrize"
msgid ""
"Congratulations!\n"
"You've got the quiz right!\p"
"You've won a prize provided by\n"
"{STR_VAR_1}!$"
msgstr ""
"恭喜你！\n"
"你答对了！\p"
"你赢得了\n"
"{STR_VAR_1}提供的奖品！$"

#: data/scripts/lilycove_lady.inc:647
msgctxt "LilycoveCity_PokemonCenter_1F_Text_XReceivedOneY"
msgid ""
"{STR_VAR_1} received\n"
"one {STR_VAR_2}!$"
msgstr ""
"{STR_VAR_1}得到了\n"
"{STR_VAR_2}！$"

#: data/scripts/lilycove_lady.inc:651
msgctxt "LilycoveCity_PokemonCenter_1F_Text_YourBagIsFilledUp"
msgid ""
"Oh? Your BAG is filled up!\n"
"Come see me when you have room.$"
msgstr ""
"哦？你的背包已经满了！\n"
"等有空位了再来找我吧。$"

#: data/scripts/lilycove_lady.inc:655
msgctxt "LilycoveCity_PokemonCenter_1F_Text_WrongTheCorrectAnswerIs"
msgid ""
"Hmm… Wrong!\n"
"The correct answer is “{STR_VAR_3}”!$"
msgstr ""
"嗯……答错了！\n"
"正确答案是“{STR_VAR_3}”！$"

#: data/scripts/lilycove_lady.inc:659
msgctxt "LilycoveCity_PokemonCenter_1F_Text_IGetToKeepPrize"
msgid ""
"Too bad!\p"
"I get to keep the quiz prize\n"
"{STR_VAR_1} now!$"
msgstr ""
"真遗憾！\p"
"猜谜的奖品{STR_VAR_1}\n"
"现在归我了！$"

#: data/scripts/lilycove_lady.inc:664
msgctxt "LilycoveCity_PokemonCenter_1F_Text_MakeYourOwnQuiz"
msgid ""
"Listen, listen!\n"
"Would you like to make your own quiz?$"
msgstr ""
"听我说，听我说！\n"
"你想自己出一道题吗？$"

#: data/scripts/lilycove_lady.inc:668
msgctxt "LilycoveCity_PokemonCenter_1F_Text_MaybeNextTime"
msgid ""
"Oh, I see…\n"
"Well, maybe next time!$"
msgstr ""
"哦，这样啊……\n"
"那就下次吧！$"

#: data/scripts/lilycove_lady.inc:672
msgctxt "LilycoveCity_PokemonCenter_1F_Text_PickYourPrize"
msgid ""
"Okay, the first thing you have to do\n"
"is pick the prize for the person that\l"
"answers your quiz correctly.\p"
"But beware, if the person taking\n"
"the quiz can't get it right, I get to\l"
"keep the prize!$"
msgstr ""
"好，首先你要选好\n"
"送给答对的人的奖品。\p"
"不过要注意，如果答题的人\n"
"没有答对，奖品就归我了！$"

#: data/scripts/lilycove_lady.inc:680
msgctxt "LilycoveCity_PokemonCenter_1F_Text_QuitChoosingPrize"
msgid ""
"If you don't choose a prize,\n"
"your quiz can't be made.\p"
"Are you going to quit making\n"
"your quiz?$"
msgstr ""
"如果不选择奖品，\n"
"就没办法出题了。\p"
"要放弃出题吗？$"

#: data/scripts/lilycove_lady.inc:686
msgctxt "LilycoveCity_PokemonCenter_1F_Text_WriteYourQuiz"
msgid ""
"Oh, how nice!\n"
"That's a wonderful prize!\p"
"Next, you need to write your quiz\n"
"question and its answer.$"
msgstr ""
"哎呀，真不错！\n"
"真是很棒的奖品！\p"
"接下来，你要写出\n"
"题目和答案。$"

#: data/scripts/lilycove_lady.inc:692
msgctxt "LilycoveCity_PokemonCenter_1F_Text_QuitWritingQuizQuestion"
msgid ""
"Are you going to quit writing\n"
"your quiz question?$"
msgstr "要放弃编写题目吗？$"

#: data/scripts/lilycove_lady.inc:697
msgctxt "LilycoveCity_PokemonCenter_1F_Text_QuitWritingQuizAnswer"
msgid ""
"Are you going to quit choosing\n"
"your quiz answer?$"
msgstr "要放弃选择答案吗？$"

#: data/scripts/lilycove_lady.inc:701
msgctxt "LilycoveCity_PokemonCenter_1F_Text_IllLookForAChallenger"
msgid ""
"Thank you!\n"
"You've put together a nice quiz.\p"
"I'll go look for someone who'll take\n"
"your quiz challenge right away.$"
msgstr ""
"谢谢你！\n"
"你出了一道很棒的题目。\p"
"我马上就去找人\n"
"来挑战你的题目。$"

#: data/scripts/lilycove_lady.inc:707
msgctxt "LilycoveCity_PokemonCenter_1F_Text_ImTheContestLady"
msgid ""
"I'm the CONTEST LADY!\n"
"I sure do love CONTESTS!$"
msgstr ""
"我是华丽大赛大姐姐！\n"
"我最喜欢华丽大赛了！$"

#: data/scripts/lilycove_lady.inc:711
msgctxt "LilycoveCity_PokemonCenter_1F_Text_ThankForPokeblock"
msgid "Thanks for your {POKEBLOCK} before!$"
msgstr "谢谢你之前给我的宝可方块！$"

#: data/scripts/lilycove_lady.inc:714
msgctxt "LilycoveCity_PokemonCenter_1F_Text_MyFriendDisplaysQuality"
msgid ""
"This is my friend {STR_VAR_1}!\n"
"It's the epitome of {STR_VAR_2}!\p"
"But I think that it will display\n"
"even more {STR_VAR_2}!$"
msgstr ""
"这是我的朋友{STR_VAR_1}！\n"
"它简直就是{STR_VAR_2}的化身！\p"
"不过我觉得它还能\n"
"展现出更多的{STR_VAR_2}！$"

#: data/scripts/lilycove_lady.inc:720
msgctxt "LilycoveCity_PokemonCenter_1F_Text_DontHaveAPokeblockCase"
msgid ""
"So, I need your help!\p"
"Please, may I have one {POKEBLOCK}?\n"
"All I'm asking for is one!\p"
"…Oh, but…\n"
"Don't you have a {POKEBLOCK} CASE?\l"
"That's no good. Next time, then!$"
msgstr ""
"所以，我需要你的帮助！\p"
"能给我一个宝可方块吗？\n"
"我只要一个就好！\p"
"……哦，可是……\n"
"你没有宝可方块盒吗？\l"
"那就没办法了。下次再说吧！$"

#: data/scripts/lilycove_lady.inc:728
msgctxt "LilycoveCity_PokemonCenter_1F_Text_AskingForOnePokeblock"
msgid ""
"So, I need your help!\p"
"Please, may I have one {POKEBLOCK}?\n"
"All I'm asking for is one!$"
msgstr ""
"所以，我需要你的帮助！\p"
"能给我一个宝可方块吗？\n"
"我只要一个就好！$"

#: data/scripts/lilycove_lady.inc:733
msgctxt "LilycoveCity_PokemonCenter_1F_Text_ICantHaveOnePokeblock"
msgid ""
"Awww!\n"
"I can't have one {POKEBLOCK}?!$"
msgstr ""
"啊——！\n"
"连一个宝可方块都不给我吗？！$"

#: data/scripts/lilycove_lady.inc:737
msgctxt "LilycoveCity_PokemonCenter_1F_Text_WhatACheapskate"
msgid ""
"Sheesh!\n"
"What a cheapskate!$"
msgstr ""
"真是的！\n"
"你可真小气！$"

#: data/scripts/lilycove_lady.inc:741
msgctxt "LilycoveCity_PokemonCenter_1F_Text_IllUseYourPokeblock"
msgid ""
"Yay!\n"
"Thank you!\p"
"I'll feed my POKéMON your {POKEBLOCK}\n"
"right away.$"
msgstr ""
"耶！\n"
"谢谢你！\p"
"我马上就把你的宝可方块\n"
"喂给我的宝可梦。$"

#: data/scripts/lilycove_lady.inc:747
msgctxt "LilycoveCity_PokemonCenter_1F_Text_NoChangeThanks"
msgid ""
"…It doesn't seem to have changed\n"
"in any way at all…\p"
"Hmm…\p"
"Oh, well!\n"
"Thank you very much!$"
msgstr ""
"……好像一点变化\n"
"都没有……\p"
"嗯……\p"
"哎，算了！\n"
"非常感谢你！$"

#: data/scripts/lilycove_lady.inc:754
msgctxt "LilycoveCity_PokemonCenter_1F_Text_ReallyImprovedThanks"
msgid ""
"Oh, yay!\n"
"It's really delighted!\p"
"I think it really improved {STR_VAR_1}'s\n"
"{STR_VAR_2} quality, too.\p"
"Thank you so much!$"
msgstr ""
"哇，太好了！\n"
"它真的很高兴！\p"
"我觉得{STR_VAR_1}的{STR_VAR_2}\n"
"也真的提升了。\p"
"太感谢你了！$"

#: data/scripts/lilycove_lady.inc:761
msgctxt "LilycoveCity_PokemonCenter_1F_Text_ReadyToEnterContests"
msgid ""
"Hmm…\p"
"I think we may be ready to enter\n"
"some CONTESTS.\p"
"If you see us in one somewhere,\n"
"I hope you'll cheer for us.$"
msgstr ""
"嗯……\p"
"我觉得我们差不多\n"
"可以参加华丽大赛了。\p"
"如果你在哪里看到我们参赛，\n"
"希望你能为我们加油。$"

#: data/scripts/lilycove_lady.inc:768
msgctxt "LilycoveCity_PokemonCenter_1F_Text_Zigzagoon"
msgid "{STR_VAR_1}: Guguuh!$"
msgstr "{STR_VAR_1}：咕咕呜！$"

#: data/scripts/lilycove_lady.inc:771
msgctxt "LilycoveCity_PokemonCenter_1F_Text_Kecleon"
msgid "{STR_VAR_1}: Igigigiiih!$"
msgstr "{STR_VAR_1}：咿叽叽叽咿！$"

#: data/scripts/lilycove_lady.inc:774
msgctxt "LilycoveCity_PokemonCenter_1F_Text_Poochyena"
msgid "{STR_VAR_1}: Baaarun…$"
msgstr "{STR_VAR_1}：哇呜呜……$"

#: data/scripts/lilycove_lady.inc:777
msgctxt "LilycoveCity_PokemonCenter_1F_Text_Pikachu"
msgid "{STR_VAR_1}: Pikka!$"
msgstr "{STR_VAR_1}：皮卡！$"

#: data/scripts/lilycove_lady.inc:780
msgctxt "LilycoveCity_PokemonCenter_1F_Text_Skitty"
msgid "{STR_VAR_1}: Umyaaaan!$"
msgstr "{STR_VAR_1}：喵呀——！$"
