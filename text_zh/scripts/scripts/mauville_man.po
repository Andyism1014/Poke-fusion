msgstr ""
"这是一位名叫{STR_VAR_3}的\n"
"训练家的故事。\p"
"这位训练家从蛋里\n"
"孵化出了{STR_VAR_1}只宝可梦！\p"
"{STR_VAR_3}是传说中的\n"
"孵蛋高手！$"

#: data/scripts/mauville_man.inc:412
msgctxt "MauvilleCity_PokemonCenter_1F_Text_PokemonEvolvedTitle"
msgid "The Evolver TRAINER$"
msgstr "进化达人训练家$"

#: data/scripts/mauville_man.inc:415
msgctxt "MauvilleCity_PokemonCenter_1F_Text_PokemonEvolvedAction"
