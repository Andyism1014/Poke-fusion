#: data/scripts/mauville_man.inc:357
msgctxt "MauvilleCity_PokemonCenter_1F_Text_TrainerBattlesTitle"
msgid "The Battle-Happy TRAINER$"
msgstr "爱对战的训练家$"

#: data/scripts/mauville_man.inc:360
msgctxt "MauvilleCity_PokemonCenter_1F_Text_TrainerBattlesAction"
