msgstr "用钓竿钓到了宝可梦$"

#: data/scripts/mauville_man.inc:390
msgctxt "MauvilleCity_PokemonCenter_1F_Text_FishingPokemonCaughtStory"
msgid ""
"This is a tale of a TRAINER\n"
"named {STR_VAR_3}.\p"
"This TRAINER caught\n"
"{STR_VAR_1} POKéMON while fishing!\p"
"{STR_VAR_3} is a legendary fishing\n"
