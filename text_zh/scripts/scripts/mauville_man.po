msgstr ""
"这是一位名叫{STR_VAR_3}的\n"
"训练家的故事。\p"
"这位训练家引领了\n"
"{STR_VAR_1}次新潮流！\p"
"{STR_VAR_3}正在引领\n"
"整个丰缘地区的潮流！$"

#: data/scripts/mauville_man.inc:315
msgctxt "MauvilleCity_PokemonCenter_1F_Text_BerriesPlantedTitle"
msgid "The BERRY-Planting TRAINER$"
msgstr "种树果的训练家$"

