msgstr "让宝可梦进化了$"

#: data/scripts/mauville_man.inc:418
msgctxt "MauvilleCity_PokemonCenter_1F_Text_PokemonEvolvedStory"
msgid ""
"This is a tale of a TRAINER\n"
"named {STR_VAR_3}.\p"
"This TRAINER made {STR_VAR_1} POKéMON\n"
