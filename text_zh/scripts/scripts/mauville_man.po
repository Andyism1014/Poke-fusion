msgstr "孵化了蛋$"

#: data/scripts/mauville_man.inc:404
msgctxt "MauvilleCity_PokemonCenter_1F_Text_EggsHatchedStory"
msgid ""
"This is a tale of a TRAINER\n"
"named {STR_VAR_3}.\p"
"This TRAINER hatched {STR_VAR_1} POKéMON\n"
"from EGGS!\p"
"{STR_VAR_3} is a legendary warmer\n"
