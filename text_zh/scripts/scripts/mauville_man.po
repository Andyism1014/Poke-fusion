msgstr ""
"这是一位名叫{STR_VAR_3}的\n"
"训练家的故事。\p"
"这位训练家捕捉了\n"
"{STR_VAR_1}只宝可梦！\p"
"{STR_VAR_3}是传说中的\n"
"野生宝可梦捕手！$"

#: data/scripts/mauville_man.inc:384
msgctxt "MauvilleCity_PokemonCenter_1F_Text_FishingPokemonCaughtTitle"
msgid "The Fishing TRAINER$"
msgstr "爱钓鱼的训练家$"

#: data/scripts/mauville_man.inc:387
msgctxt "MauvilleCity_PokemonCenter_1F_Text_FishingPokemonCaughtAction"
