msgstr "进行了对战$"

#: data/scripts/mauville_man.inc:363
msgctxt "MauvilleCity_PokemonCenter_1F_Text_TrainerBattlesStory"
msgid ""
"This is a tale of a TRAINER\n"
"named {STR_VAR_3}.\p"
"This TRAINER battled {STR_VAR_1} times!\p"
"{STR_VAR_3} must be a TRAINER who can\n"
