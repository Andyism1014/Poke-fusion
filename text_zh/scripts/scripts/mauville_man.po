"{STR_VAR_3} is the ultimate evolver\n"
"of POKéMON!$"
msgstr ""
"这是一位名叫{STR_VAR_3}的\n"
"训练家的故事。\p"
"这位训练家让\n"
"{STR_VAR_1}只宝可梦进化了！\p"
"{STR_VAR_3}是终极的\n"
"宝可梦进化大师！$"

#: data/scripts/mauville_man.inc:426
msgctxt "MauvilleCity_PokemonCenter_1F_Text_UsedPokemonCenterTitle"
msgid "The POKéMON CENTER-Loving TRAINER$"
msgstr "爱宝可梦中心的训练家$"

#: data/scripts/mauville_man.inc:429
msgctxt "MauvilleCity_PokemonCenter_1F_Text_UsedPokemonCenterAction"
msgid "Used POKéMON CENTERS$"
msgstr "使用了宝可梦中心$"

#: data/scripts/mauville_man.inc:432
msgctxt "MauvilleCity_PokemonCenter_1F_Text_UsedPokemonCenterStory"
msgid ""
"This is a tale of a TRAINER\n"
"named {STR_VAR_3}.\p"
"This TRAINER healed POKéMON\n"
"{STR_VAR_1} times at POKéMON CENTERS!\p"
"There could be no greater lover of\n"
"POKéMON CENTERS than {STR_VAR_3}!$"
msgstr ""
"这是一位名叫{STR_VAR_3}的\n"
"训练家的故事。\p"
"这位训练家在宝可梦中心\n"
"为宝可梦恢复了{STR_VAR_1}次！\p"
"再也没有人比{STR_VAR_3}\n"
"更爱宝可梦中心了！$"

#: data/scripts/mauville_man.inc:440
msgctxt "MauvilleCity_PokemonCenter_1F_Text_RestedAtHomeTitle"
