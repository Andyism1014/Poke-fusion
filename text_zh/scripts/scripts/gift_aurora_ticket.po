#: data/scripts/gift_aurora_ticket.inc:37
msgctxt "sText_AuroraTicketForYou"
msgid ""
"Thank you for using the MYSTERY\n"
"GIFT System.\p"
"You must be {PLAYER}.\n"
"There is a ticket here for you.$"
msgstr ""
"感谢你使用神秘礼物系统。\p"
"你就是{PLAYER}吧。\n"
"这里有一张给你的船票。$"

#: data/scripts/gift_aurora_ticket.inc:43
msgctxt "sText_AuroraTicketUseAtPort"
msgid ""
"It appears to be for use at the\n"
"LILYCOVE CITY port.\p"
"Why not give it a try and see what\n"
"it is about?$"
msgstr ""
"这好像是在\n"
"水静市港口使用的。\p"
"要不要去试试看，\n"
"看看会发生什么？$"

#: data/scripts/gift_aurora_ticket.inc:49
msgctxt "sText_AuroraTicketThankYou"
msgid ""
"Thank you for using the MYSTERY\n"
"GIFT System.$"
msgstr "感谢你使用神秘礼物系统。$"

#: data/scripts/gift_aurora_ticket.inc:53
msgctxt "sText_AuroraTicketBagFull"
msgid ""
"Oh, I'm sorry, {PLAYER}.\n"
"Your BAG's KEY ITEMS POCKET is full.\p"
"Please store something on your PC,\n"
"then come back for this.$"
msgstr ""
"哎呀，抱歉，{PLAYER}。\n"
"你背包的重要物品口袋已经满了。\p"
"请先把东西存到电脑里，\n"
"再来领取吧。$"
