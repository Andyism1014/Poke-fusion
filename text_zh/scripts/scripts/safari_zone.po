#: data/scripts/safari_zone.inc:114
msgctxt "Route121_SafariZoneEntrance_Text_WelcomeToSafariZone"
msgid ""
"Welcome to the SAFARI ZONE!\p"
"Here, you may witness many kinds of\n"
"POKéMON rarely seen in HOENN.\p"
"And, you'll see them in their wild,\n"
"untamed state in natural habitats.\p"
"What's more, we've thrown open the\n"
"gates to POKéMON TRAINERS.\p"
"You're encouraged to catch POKéMON\n"
"for keeps!\p"
"Come in and enjoy the SAFARI ZONE!$"
msgstr ""

#: data/scripts/safari_zone.inc:126
msgctxt "Route121_SafariZoneEntrance_Text_WelcomeFirstTime"
msgid ""
"Welcome to the SAFARI ZONE!\n"
"Is it your first time here?$"
msgstr ""

#: data/scripts/safari_zone.inc:130
msgctxt "Route121_SafariZoneEntrance_Text_ComeInAndEnjoy"
msgid "Come in and enjoy the SAFARI ZONE!$"
msgstr ""

#: data/scripts/safari_zone.inc:133
msgctxt "Route121_SafariZoneEntrance_Text_FirstTimeInfo"
msgid ""
"When you enter the SAFARI ZONE, you\n"
"start with 30 SAFARI BALLS for\l"
"catching POKéMON.\p"
"The SAFARI Game is over when you run\n"
"out of SAFARI BALLS, or when you've\l"
"walked 500 steps.\p"
"Come in and enjoy the SAFARI ZONE!$"
msgstr ""

#: data/scripts/safari_zone.inc:142
msgctxt "Route121_SafariZoneEntrance_Text_WouldYouLikeToPlay"
msgid ""
"Welcome to the SAFARI ZONE!\p"
"All you can catch for just ¥500!\n"
"Would you like to play a SAFARI Game?$"
msgstr ""

#: data/scripts/safari_zone.inc:147
msgctxt "Route121_SafariZoneEntrance_Text_PlayAnotherTime"
msgid ""
"Okay.\n"
"Please play another time!$"
msgstr ""

#: data/scripts/safari_zone.inc:151
msgctxt "Route121_SafariZoneEntrance_Text_NotEnoughMoney"
msgid ""
"You don't have enough money.\n"
"Sorry.$"
msgstr ""

#: data/scripts/safari_zone.inc:155
msgctxt "Route121_SafariZoneEntrance_Text_ThatWillBe500Please"
msgid "That will be ¥500, please.$"
msgstr ""

#: data/scripts/safari_zone.inc:158
msgctxt "Route121_SafariZoneEntrance_Text_HereAreYourSafariBalls"
msgid "Here are your SAFARI BALLS.$"
msgstr ""

#: data/scripts/safari_zone.inc:161
msgctxt "Route121_SafariZoneEntrance_Text_Received30SafariBalls"
msgid "{PLAYER} received 30 SAFARI BALLS.$"
msgstr ""

#: data/scripts/safari_zone.inc:164
msgctxt "Route121_SafariZoneEntrance_Text_PleaseEnjoyYourself"
msgid ""
"We'll let you know when your game\n"
"is over.\p"
"So, until then, enjoy yourself, please!\n"
"Off you go on your wild excursion!$"
msgstr ""

#: data/scripts/safari_zone.inc:170
msgctxt "Route121_SafariZoneEntrance_Text_PCIsFull"
msgid ""
"Excuse me!\n"
"Your PC BOX is full.$"
msgstr ""

#: data/scripts/safari_zone.inc:174
msgctxt "Route121_SafariZoneEntrance_Text_YouNeedPokeblockCase"
msgid ""
"Excuse me!\n"
"You seem to be without a {POKEBLOCK} CASE.\p"
"Your SAFARI Game will be much more\n"
"fruitful if you use {POKEBLOCK}S.\p"
"Please come back with a {POKEBLOCK} CASE.\p"
"You may obtain a {POKEBLOCK} CASE from\n"
"the LILYCOVE CONTEST HALL.$"
msgstr ""

#: data/scripts/safari_zone.inc:183
msgctxt "SafariZone_South_Text_StillHaveTimeExit"
msgid ""
"You still have time left. Would you like\n"
"to exit the SAFARI ZONE now?$"
msgstr ""

#: data/scripts/safari_zone.inc:187
msgctxt "SafariZone_South_Text_EnjoyTheRestOfYourAdventure"
msgid ""
"Please enjoy the rest of your wild\n"
"adventure!$"
msgstr ""

#: data/scripts/safari_zone.inc:191
msgctxt "SafariZone_South_Text_ExitEarlyThankYouForPlaying"
msgid ""
"Okay.\p"
"I'll take back your remaining SAFARI\n"
"BALLS.\p"
"Thank you for playing.\n"
"We hope to see you again.$"
msgstr ""

#: data/scripts/safari_zone.inc:198
msgctxt "SafariZone_South_Text_GoodLuck"
msgid ""
"Good luck!\p"
"If you need anything, don't hesitate\n"
"to tell me, please!$"
msgstr ""

#: data/scripts/safari_zone.inc:203
msgctxt "SafariZone_South_Text_Boy"
msgid ""
"Did you know?\p"
"If you put a {POKEBLOCK} in that square box,\n"
"POKéMON gather around.$"
msgstr ""

#: data/scripts/safari_zone.inc:208
msgctxt "SafariZone_South_Text_Man"
msgid ""
"I want to keep going deeper, but I\n"
"forgot to bring a BIKE.\p"
"Something tells me that rare POKéMON\n"
"live in the outlying areas.$"
msgstr ""

#: data/scripts/safari_zone.inc:214
msgctxt "SafariZone_Southwest_Text_Woman"
msgid ""
"Sometimes, when I toss a {POKEBLOCK} at \n"
"POKéMON, it gets ignored.\p"
"Do POKéMON have likes and dislikes\n"
"about what they eat?$"
msgstr ""

#: data/scripts/safari_zone.inc:220
msgctxt "SafariZone_Northwest_Text_Man"
msgid ""
"Gasp… Gasp…\n"
"I…made it out here…but…\p"
"I'm exhausted… I don't have the\n"
"energy to catch POKéMON…$"
msgstr ""

#: data/scripts/safari_zone.inc:226
msgctxt "SafariZone_North_Text_Fisherman"
msgid ""
"I'm on a mission to find WATER POKéMON\n"
"you don't see in HOENN.\p"
"Do you have any idea where the lake is?$"
msgstr ""

#: data/scripts/safari_zone.inc:231
msgctxt "SafariZone_North_Text_Man"
msgid ""
"I'm going to catch a lot of rare POKéMON\n"
"here and trade them with my friends!$"
msgstr ""

#: data/scripts/safari_zone.inc:235
msgctxt "SafariZone_South_Text_Youngster"
msgid ""
"I put a {POKEBLOCK} on the {POKEBLOCK} FEEDER.\n"
"But it seems to have disappeared.\p"
"I guess POKéMON must have eaten it\n"
"without me noticing.$"
msgstr ""

#: data/scripts/safari_zone.inc:241
msgctxt "Route121_SafariZoneEntrance_Text_TrainerTip"
msgid ""
"SAFARI ZONE TRAINER TIP!\p"
"Throw {POKEBLOCK}S at wild POKéMON to make\n"
"them less likely to flee.$"
msgstr ""

#: data/scripts/safari_zone.inc:246
msgctxt "SafariZone_Southwest_Text_RestHouseSign"
msgid ""
"“Relieve your tired feet.”\n"
"REST HOUSE$"
msgstr ""

#: data/scripts/safari_zone.inc:250
msgctxt "SafariZone_RestHouse_Text_Youngster"
msgid ""
"I don't have any {POKEBLOCK}S, but I caught\n"
"a good number of POKéMON.\p"
"You can improve your chances of making\n"
"a catch by getting closer to them\l"
"before throwing a SAFARI BALL.$"
msgstr ""

#: data/scripts/safari_zone.inc:257
msgctxt "SafariZone_RestHouse_Text_PsychicM"
msgid ""
"If you use {POKEBLOCK}S, wild POKéMON won't\n"
"be so quick to run away.\p"
"It's not much use to give {POKEBLOCK}S to\n"
"POKéMON that don't flee easily.$"
msgstr ""

#: data/scripts/safari_zone.inc:263
msgctxt "SafariZone_RestHouse_Text_FatMan"
msgid ""
"If you put a {POKEBLOCK} on the FEEDER,\n"
"POKéMON are attracted to it.\p"
"I think POKéMON with the same sort of\n"
"nature are drawn by a certain {POKEBLOCK}.$"
msgstr ""

#: data/scripts/safari_zone.inc:269
msgctxt "SafariZone_South_Text_AreaOffLimits1"
msgid ""
"This area is still under construction.\n"
"It's off-limits, sorry!$"
msgstr ""

#: data/scripts/safari_zone.inc:273
msgctxt "SafariZone_Southeast_Text_ExpansionIsFinished"
msgid ""
"The SAFARI ZONE's expansion project\n"
"is finished now.\p"
"We hope you will enjoy the new area.$"
msgstr ""

#: data/scripts/safari_zone.inc:278
msgctxt "SafariZone_South_Text_AreaOffLimits2"
msgid ""
"This area is still under construction.\n"
"It's off-limits, sorry!$"
msgstr ""

#: data/scripts/safari_zone.inc:282
msgctxt "SafariZone_Southeast_Text_LittleGirl"
msgid ""
"Wow! Whee! I haven't seen any of\n"
"these POKéMON before!$"
msgstr ""

#: data/scripts/safari_zone.inc:286
msgctxt "SafariZone_Southeast_Text_FatMan"
msgid ""
"The POKéMON in this area are all\n"
"new to me.\p"
"And I'm allowed to catch these rare\n"
"POKéMON! Too cool!$"
msgstr ""

#: data/scripts/safari_zone.inc:292
msgctxt "SafariZone_Southeast_Text_RichBoy"
msgid ""
"The POKéMON around here seem to be\n"
"from somewhere other than HOENN.$"
msgstr ""

#: data/scripts/safari_zone.inc:296
msgctxt "SafariZone_Northeast_Text_Boy"
msgid ""
"I only have a couple SAFARI BALLS left.\p"
"I'm having a hard time trying to\n"
"decide what I should catch.$"
msgstr ""

#: data/scripts/safari_zone.inc:301
msgctxt "SafariZone_Northeast_Text_Woman"
msgid ""
"I heard that you can see PIKACHU here.\n"
"Where might one be?$"
msgstr ""

#: data/scripts/safari_zone.inc:305
msgctxt "SafariZone_Northeast_Text_Girl"
msgid ""
"Oh, boo!\n"
"I can't seem to catch anything!\p"
"I'll end up wasting the admission\n"
"price if I don't catch something!$"
msgstr ""
