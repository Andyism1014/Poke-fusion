#: data/scripts/secret_base.inc:1
msgctxt "SecretBase_Text_TreeCanBeClimbed"
msgid ""
"If some vines drop down, this tree can\n"
"be climbed.$"
msgstr ""
"如果有藤蔓垂下来，\n"
"就能爬上这棵树了。$"

#: data/scripts/secret_base.inc:5
msgctxt "SecretBase_Text_TreeUseSecretPower"
msgid ""
"If some vines drop down, this tree can\n"
"be climbed.\p"
"Use the SECRET POWER?$"
msgstr ""
"如果有藤蔓垂下来，\n"
"就能爬上这棵树了。\p"
"要使用秘密之力吗？$"

#: data/scripts/secret_base.inc:10
msgctxt "SecretBase_Text_VineDroppedDown"
msgid "A thick vine dropped down!$"
msgstr "一根粗粗的藤蔓垂了下来！$"

#: data/scripts/secret_base.inc:13
msgctxt "SecretBase_Text_ClumpOfGrass"
msgid ""
"If this clump of grass can be moved,\n"
"it might be possible to go inside.$"
msgstr ""
"如果能拨开这丛草，\n"
"或许就能进到里面去。$"

#: data/scripts/secret_base.inc:17
msgctxt "SecretBase_Text_ClumpUseSecretPower"
msgid ""
"If this clump of grass can be moved,\n"
"it might be possible to go inside.\p"
"Use the SECRET POWER?$"
msgstr ""
"如果能拨开这丛草，\n"
"或许就能进到里面去。\p"
"要使用秘密之力吗？$"

#: data/scripts/secret_base.inc:22
msgctxt "SecretBase_Text_DiscoveredSmallEntrance"
msgid "Discovered a small entrance!$"
msgstr "发现了一个小小的入口！$"

#: data/scripts/secret_base.inc:673
msgctxt "SecretBase_Text_AllDecorationsWillBeReturned"
msgid ""
"All decorations and furniture in your\n"
"SECRET BASE will be returned to your PC.\p"
"Is that okay?$"
msgstr ""
"秘密基地里所有的装饰品和家具\n"
"都会被送回你的电脑。\p"
"可以吗？$"

#: data/scripts/secret_base.inc:678
msgctxt "SecretBase_Text_WantToRegisterSecretBase"
msgid ""
"Do you want to register\n"
"{STR_VAR_1}'s SECRET BASE?$"
msgstr ""
"要登录{STR_VAR_1}的\n"
"秘密基地吗？$"

#: data/scripts/secret_base.inc:682
msgctxt "SecretBase_Text_AlreadyRegisteredDelete"
msgid ""
"This data is already registered.\n"
"Would you like to delete it?$"
msgstr ""
"这份数据已经登录过了。\n"
"要删除吗？$"

#: data/scripts/secret_base.inc:686
msgctxt "SecretBase_Text_TooManyBasesDeleteSome"
msgid ""
"Up to 10 locations can be registered.\p"
"Delete a location if you want to\n"
"register another location.$"
msgstr ""
"最多可以登录10个地点。\p"
"如果想登录其他地点，\n"
"请先删除一个地点。$"

#: data/scripts/secret_base.inc:691
msgctxt "SecretBase_Text_RegistrationCompleted"
msgid "Registration completed.$"
msgstr "登录完成了。$"

#: data/scripts/secret_base.inc:694
msgctxt "SecretBase_Text_DataUnregistered"
msgid "Data has been unregistered.$"
msgstr "已取消登录数据。$"

#: data/scripts/secret_base.inc:697
msgctxt "SecretBase_Text_BootUpPC"
msgid "{PLAYER} booted up the PC.$"
msgstr "{PLAYER}打开了电脑。$"

#: data/scripts/secret_base.inc:700
msgctxt "SecretBase_Text_WhatWouldYouLikeToDo"
msgid "What would you like to do?$"
msgstr "要做什么呢？$"

#: data/scripts/secret_base.inc:703
msgctxt "SecretBase_Text_RegistryInfo"
msgid ""
"Once registered, a SECRET BASE will not\n"
"disappear unless the other TRAINER\l"
"moves it to a different location.\p"
"If a SECRET BASE is deleted from the\n"
"registered list, another one may take\l"
"its place.\p"
"Up to ten SECRET BASE locations\n"
"may be registered.$"
msgstr ""
"登录后的秘密基地，除非其他训练家\n"
"把它搬到别的地方，否则不会消失。\p"
"如果从登录列表中删除\n"
"某个秘密基地，\l"
"其他秘密基地可能会取而代之。\p"
"最多可以登录\n"
"10个秘密基地的地点。$"

#: data/scripts/secret_base.inc:713
msgctxt "SecretBase_Text_BattleTowerShield"
msgid ""
"A shield of {STR_VAR_2} that marks winning\n"
"{STR_VAR_1} times in a row at the BATTLE TOWER.$"
msgstr ""
"纪念在对战塔连胜{STR_VAR_1}场的\n"
"{STR_VAR_2}盾牌。$"

#: data/scripts/secret_base.inc:717
msgctxt "SecretBase_Text_ToyTV"
msgid ""
"A realistic toy TV. It could be easily\n"
"mistaken for the real thing.$"
msgstr ""
"一台逼真的玩具电视。\n"
"很容易被误认为是真的。$"

#: data/scripts/secret_base.inc:721
msgctxt "SecretBase_Text_SeedotTV"
msgid ""
"A toy TV shaped like a SEEDOT.\n"
"It looks ready to roll away on its own…$"
msgstr ""
"橡实果造型的玩具电视。\n"
"好像随时会自己滚走……$"

#: data/scripts/secret_base.inc:725
msgctxt "SecretBase_Text_SkittyTV"
msgid ""
"A toy TV shaped like a SKITTY.\n"
"It looks ready to stroll away…$"
msgstr ""
"向尾喵造型的玩具电视。\n"
"好像随时会自己溜走……$"

#: data/scripts/secret_base.inc:729
msgctxt "SecretBase_Text_WouldYouLikeToMoveBases"
msgid ""
"You may only make one SECRET BASE.\p"
"Would you like to move from the SECRET\n"
"BASE near {STR_VAR_1}?$"
msgstr ""
"秘密基地只能建造一个。\p"
"要搬离{STR_VAR_1}附近的\n"
"秘密基地吗？$"

#: data/scripts/secret_base.inc:734
msgctxt "SecretBase_Text_MovingCompletedUseSecretPower"
msgid ""
"Moving completed.\p"
"Would you like to use the SECRET POWER?$"
msgstr ""
"搬家完成了。\p"
"要使用秘密之力吗？$"
