#: data/scripts/contest_hall.inc:1358
msgctxt "LilycoveCity_ContestLobby_Text_ReceptionDontHavePokeblockCase"
msgid ""
"Hello!\p"
"This is the reception counter for\n"
"POKéMON CONTESTS.\p"
"Oh? It appears that you don't have\n"
"a {POKEBLOCK} CASE yet.\p"
"In that case, we need to provide you\n"
"with this!$"
msgstr ""
"你好！\p"
"这里是宝可梦华丽大赛的\n"
"报名处。\p"
"哎？你好像还没有\n"
"宝可方块盒。\p"
"既然如此，\n"
"这个就送给你吧！$"

#: data/scripts/contest_hall.inc:1367
msgctxt "LilycoveCity_ContestLobby_Text_NowThatWeveClearedThatUp"
msgid ""
"Okay, now that we've cleared that\n"
"up…\p"
"Hello!\p"
"This is the reception counter for\n"
"POKéMON CONTESTS.$"
msgstr ""
"好了，这件事已经解决了……\p"
"你好！\p"
"这里是宝可梦华丽大赛的\n"
"报名处。$"

#: data/scripts/contest_hall.inc:1374
msgctxt "LilycoveCity_ContestLobby_Text_ContestReception"
msgid ""
"Hello!\p"
"This is the reception counter for\n"
"POKéMON CONTESTS.$"
msgstr ""
"你好！\p"
"这里是宝可梦华丽大赛的\n"
"报名处。$"

#: data/scripts/contest_hall.inc:1380
msgctxt "LilycoveCity_ContestLobby_Text_CounterOnlyFor4PlayerContests"
msgid ""
"Hello!\p"
"This reception counter is only\n"
"for 4-player POKéMON CONTESTS.$"
msgstr ""
"你好！\p"
"这个报名处只受理\n"
"4人参加的宝可梦华丽大赛。$"

#: data/scripts/contest_hall.inc:1385
msgctxt "LilycoveCity_ContestLobby_Text_EnterContest1"
msgid ""
"Would you like to enter your POKéMON\n"
"in our CONTESTS?$"
msgstr ""
"要让你的宝可梦\n"
"参加华丽大赛吗？$"

#: data/scripts/contest_hall.inc:1389
msgctxt "LilycoveCity_ContestLobby_Text_WhichTopic1"
