#: data/text/blend_master.inc:1
msgctxt "BerryBlender_Text_BlendWithTheBlendMaster"
msgid ""
"BLEND MASTER: Indeed I am!\n"
"The BLEND MASTER am I!\p"
"Blend with me, and you shall witness\n"
"the mastery I bring to blending!$"
msgstr ""
"混合大师：没错，正是我！\n"
"我就是混合大师！\p"
"和我一起混合，你将见识到\n"
"我出神入化的混合技巧！$"

#: data/text/blend_master.inc:7
msgctxt "BerryBlender_Text_SeeMyMasteryInAction"
msgid ""
"BLEND MASTER: Hmmm! So, you wish to\n"
"see my mastery in action?$"
msgstr ""
"混合大师：嗯！那么，\n"
"你想见识一下我的绝技吗？$"

#: data/text/blend_master.inc:11
msgctxt "BerryBlender_Text_TooBusyNowIsee"
msgid ""
"Hmmm!\p"
"So, you are too busy now, I see!\p"
"But fear not!\n"
"I shall be here all day!\l"
"Hurry back from your errand!$"
msgstr ""
"嗯！\p"
"原来你现在很忙啊！\p"
"不过别担心！\n"
"我一整天都会在这里！\l"
"办完事就快点回来吧！$"

#: data/text/blend_master.inc:18
msgctxt "BerryBlender_Text_BlendMasterNoBerries"
msgid ""
"Hmmm!\p"
"You haven't got a single BERRY!\p"
"I shall be here all day!\n"
"Hurry back with some BERRIES!$"
msgstr ""
"嗯！\p"
"你连一颗树果都没有！\p"
"我一整天都会在这里！\n"
"带上树果快点回来吧！$"

#: data/text/blend_master.inc:24
msgctxt "BerryBlender_Text_BlendMasterKnowHowToMakePokeblocks"
msgid ""
"Of course!\n"
"Of course!\p"
"Incidentally…\n"
"You do know how to blend {POKEBLOCK}S\l"
"from BERRIES?$"
msgstr ""
"当然！\n"
"当然！\p"
"对了……\n"
"你知道怎么用树果\l"
"混合出宝可方块吧？$"

#: data/text/blend_master.inc:31
msgctxt "BerryBlender_Text_BlendMasterExplainBerryBlending"
msgid ""
"Hmmm!\p"
"Ah, but it is a simple process!\p"
"When the BLENDER's arrow comes to\n"
"your marker, just press the A Button.\p"
"That's all you have to do.\p"
"When you see how precisely I press\n"
"the A Button, you will understand.$"
msgstr ""
"嗯！\p"
"啊，这个过程很简单！\p"
"当混合器的箭头转到\n"
"你的标记时，按下A键就行了。\p"
"你要做的就只有这些。\p"
"看看我按A键有多精准，\n"
"你就会明白了。$"

#: data/text/blend_master.inc:40
msgctxt "BerryBlender_Text_BlendMasterLetsBerryBlender"
msgid ""
"Fine!\p"
"Let's get started, then!\p"
"All together with the BLEND MASTER,\n"
"let's BERRY BLENDER!$"
msgstr ""
"好！\p"
"那我们开始吧！\p"
"和混合大师一起，\n"
"来混合树果吧！$"

#: data/text/blend_master.inc:46
msgctxt "BerryBlender_Text_BlendMasterNoPokeblockCase"
msgid ""
"Hmmm!\p"
"You don't appear to have gotten\n"
"the {POKEBLOCK} CASE!\p"
"I shall be here all day!\n"
"Obtain the {POKEBLOCK} CASE and hurry back!$"
msgstr ""
"嗯！\p"
"你好像还没有\n"
"宝可方块盒！\p"
"我一整天都会在这里！\n"
"拿到宝可方块盒就快点回来吧！$"

#: data/text/blend_master.inc:53
msgctxt "BerryBlender_Text_BlendMasterPokeblockCaseFull"
msgid ""
"Hmmm!\p"
"Your {POKEBLOCK} CASE appears to be full!\p"
"I shall be here all day!\n"
"Use some {POKEBLOCK}S and hurry back!$"
msgstr ""
"嗯！\p"
"你的宝可方块盒好像已经满了！\p"
"我一整天都会在这里！\n"
"用掉一些宝可方块再快点回来吧！$"

#: data/text/blend_master.inc:59
msgctxt "BerryBlender_Text_WhoaAwesome"
msgid ""
"Whoa!\n"
"Awesome!$"
msgstr ""
"哇！\n"
"太厉害了！$"

#: data/text/blend_master.inc:63
msgctxt "BerryBlender_Text_WickedlyFast"
msgid "Wickedly fast!$"
msgstr "快得不得了！$"

#: data/text/blend_master.inc:66
msgctxt "BerryBlender_Text_WhatAnExpert"
msgid "What an expert!$"
msgstr "真是个高手！$"

#: data/text/blend_master.inc:69
msgctxt "BerryBlender_Text_MadeAmazingPokeblocksWithMaster"
msgid ""
"When I blended with the MASTER,\n"
"we made amazing {POKEBLOCK}S!$"
msgstr ""
"我和大师一起混合时，\n"
"做出了很棒的宝可方块！$"

#: data/text/blend_master.inc:73
msgctxt "BerryBlender_Text_QualitiesOfBlendMaster"
msgid ""
"Eyes that track the arrow with\n"
"machinelike intensity…\p"
"A hand that taps the A Button\n"
"with clockwork-like precision…\p"
"Possessing these qualities makes\n"
"the BLEND MASTER truly great.$"
msgstr ""
"像机器一样\n"
"紧紧追踪箭头的双眼……\p"
"像钟表一样\n"
"精准按下A键的手……\p"
"正是拥有这些特质，\n"
"混合大师才如此伟大。$"

#: data/text/blend_master.inc:81
msgctxt "BerryBlender_Text_MasterWorksOnSkillsInMountains"
msgid ""
"The BLEND MASTER's supposed to work\n"
"on his skills deep in the mountains.\p"
"Sometimes, he comes to LILYCOVE\n"
"to blend BERRIES all day long.$"
msgstr ""
"听说混合大师\n"
"在深山里磨练技艺。\p"
"有时候，他会来到水静市，\n"
"一整天都在混合树果。$"
