msgstr ""

#: data/text/battle_tent.inc:106
msgctxt "FallarborTown_BattleTentLobby_Text_ThankYouWaitWhileSaving"
msgid ""
"Thank you so much for participating!\p"
"Please wait while I save the game.$"
msgstr ""

#: data/text/battle_tent.inc:110
msgctxt "FallarborTown_BattleTentLobby_Text_AwaitAnotherChallenge2"
msgid ""
