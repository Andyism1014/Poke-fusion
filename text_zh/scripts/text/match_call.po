"And you won {STR_VAR_3} battles in a row.\p"
"Oh, there goes a rare POKéMON!\n"
"I have to go!$"
msgstr ""

#: data/text/match_call.inc:1450
msgctxt "MatchCall_BattleFrontierStreakText8"
msgid ""
"Oh, {PLAYER}{KUN}, how do you do?\n"
"This is {STR_VAR_1} speaking.\l"
"I hope you're doing well.\p"
"Oh, but, you are. I've heard that\n"
"you won {STR_VAR_3} matches in a row at\l"
"the {STR_VAR_2}.\p"
"That's very impressive!\n"
"I hope you stay successful.$"
msgstr ""

