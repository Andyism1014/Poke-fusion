msgid ""
"{STR_VAR_1} is wandering around and\n"
"searching for something."
msgstr ""
"{STR_VAR_1}正四处走动，\n"
"寻找着什么。"

#: src/data/text/follower_messages.h:252
msgid "{STR_VAR_1} is sniffing at you."
msgstr "{STR_VAR_1}正在闻你的味道。"

#: src/data/text/follower_messages.h:253
msgid ""
"{STR_VAR_1} seems to be a little\n"
"hesitant…"
msgstr ""
"{STR_VAR_1}好像\n"
"有点犹豫……"

#: src/data/text/follower_messages.h:264
msgid ""
"{STR_VAR_1} is showing off its\n"
"agility!"
msgstr ""
"{STR_VAR_1}正在炫耀\n"
"自己的敏捷！"

#: src/data/text/follower_messages.h:265
msgid ""
"{STR_VAR_1} is moving around\n"
"happily!"
msgstr ""
"{STR_VAR_1}正开心地\n"
"走来走去！"

#: src/data/text/follower_messages.h:266
msgid ""
"Woah! {STR_VAR_1} suddenly started\n"
"dancing in happiness!"
msgstr ""
"哇！{STR_VAR_1}突然\n"
"高兴得跳起舞来！"

#: src/data/text/follower_messages.h:267
msgid ""
"{STR_VAR_1} is steadily keeping up\n"
"with you!"
msgstr ""
"{STR_VAR_1}正稳稳地\n"
"跟着你！"

#: src/data/text/follower_messages.h:268
msgid ""
"{STR_VAR_1} seems to want to play\n"
"with you."
msgstr ""
"{STR_VAR_1}好像\n"
"想跟你一起玩。"

#: src/data/text/follower_messages.h:269
msgid "{STR_VAR_1} is happy skipping about."
msgstr "{STR_VAR_1}开心地蹦蹦跳跳。"

#: src/data/text/follower_messages.h:270
msgid "{STR_VAR_1} is singing and humming."
msgstr "{STR_VAR_1}正在哼着歌。"

#: src/data/text/follower_messages.h:271
msgid "{STR_VAR_1} is nipping at your feet!"
msgstr "{STR_VAR_1}正在轻咬你的脚！"

#: src/data/text/follower_messages.h:272
msgid ""
"{STR_VAR_1} turns around and looks\n"
"at you."
msgstr ""
"{STR_VAR_1}转过身来\n"
"看着你。"

#: src/data/text/follower_messages.h:273
msgid ""
"{STR_VAR_1} is working hard to show\n"
"off its mighty power!"
msgstr ""
"{STR_VAR_1}正努力展示\n"
"自己强大的力量！"

#: src/data/text/follower_messages.h:274
msgid ""
"Whoa! {STR_VAR_1} suddenly danced in\n"
"happiness!"
msgstr ""
"哇！{STR_VAR_1}突然\n"
"高兴得跳起舞来！"

#: src/data/text/follower_messages.h:275
msgid "{STR_VAR_1} is cheerful!"
msgstr "{STR_VAR_1}很快活！"

#: src/data/text/follower_messages.h:276
msgid ""
"{STR_VAR_1} is jumping around in a\n"
"carefree way!"
msgstr ""
"{STR_VAR_1}正无忧无虑地\n"
"跳来跳去！"

#: src/data/text/follower_messages.h:277
msgid ""
"Your POKéMON seems to be smelling a\n"
"nostalgically familiar scent…"
msgstr ""
"你的宝可梦好像闻到了\n"
"令人怀念的熟悉味道……"

#: src/data/text/follower_messages.h:279
msgid ""
"{STR_VAR_1} is very happy about the\n"
"rain."
msgstr ""
"{STR_VAR_1}因为下雨\n"
"非常开心。"

#: src/data/text/follower_messages.h:297
msgid ""
"{STR_VAR_1} is shivering with the\n"
"effects of being poisoned."
msgstr ""
"{STR_VAR_1}受到中毒的影响，\n"
"正在发抖。"
