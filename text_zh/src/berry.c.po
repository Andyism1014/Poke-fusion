#: src/berry.c:147
msgid "Very sweet and delicious."
msgstr "非常甜，非常美味。"

#: src/berry.c:148
msgid "Also very tender - handle with care."
msgstr "而且非常柔软，请小心拿取。"

#: src/berry.c:174
msgid "Rawst"
msgstr "莓莓"

#: src/berry.c:180
msgid "If the leaves grow long and curly,"
msgstr "叶子长得又长又卷时，"

